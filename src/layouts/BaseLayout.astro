---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Lightbox from '../components/Lightbox.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import { baseSchema } from '../data/schema';
import { getLang, localePath, ui, type Lang } from '../i18n';
import defaultOgImage from '../assets/PORTFOLIO/Portfolio_Pandabrosproductions_0050.jpg';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Solo il Portfolio usa il tema chiaro */
  theme?: 'dark' | 'light';
  /** Immagine per la condivisione (Open Graph): di default una foto del portfolio */
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Dati strutturati aggiuntivi della pagina (JSON-LD) */
  schema?: object[];
  /** Percorsi della stessa pagina nelle due lingue (hreflang e selettore EN | IT) */
  alternates?: Partial<Record<Lang, string>>;
}

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const {
  title,
  description = t.description,
  theme = 'dark',
  ogImage = defaultOgImage,
  ogImageAlt = t.hero.ogAlt,
  ogType = 'website',
  schema = [],
  alternates = { en: '/', it: localePath('it', '/') },
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : t.homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 1200×630: il formato consigliato da Facebook, WhatsApp, LinkedIn e X
const ogUrl = async (src: ImageMetadata) =>
  new URL((await getImage({ src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 })).src, Astro.site).href;
const ogImageUrl = await ogUrl(ogImage);
// L'attività ha sempre la stessa immagine, qualunque sia la pagina
const jsonLd = [...baseSchema(Astro.site!, lang, await ogUrl(defaultOgImage)), ...schema];
const abs = (path: string) => new URL(path, Astro.site).href;
// Prima visita da un browser in italiano: si passa alla versione italiana, se esiste
const itPath = lang === 'en' ? alternates.it : undefined;
---

<!doctype html>
<html lang={lang} data-theme={theme === 'light' ? 'light' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      itPath && (
        <script is:inline define:vars={{ itPath }}>
          // Italiano solo per chi ha il browser in italiano (o l'ha scelto): mai per i crawler.
          // La scelta fatta con il selettore EN | IT vince sempre.
          try {
            var pref = localStorage.getItem('lang');
            var first = (navigator.languages && navigator.languages[0]) || navigator.language || '';
            var bot = /bot|crawl|spider|slurp|preview|lighthouse/i.test(navigator.userAgent);
            if (!bot && (pref === 'it' || (!pref && /^it\b/i.test(first)))) {
              location.replace(itPath + location.hash.replace('#diary/', '#diario/'));
            }
          } catch (e) {}
        </script>
      )
    }
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.en && <link rel="alternate" hreflang="en" href={abs(alternates.en)} />}
    {alternates.it && <link rel="alternate" hreflang="it" href={abs(alternates.it)} />}
    {alternates.en && <link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />}
    {
      site.indexable ? (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      ) : (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <meta name="theme-color" content={theme === 'light' ? '#ffffff' : '#0b0b0c'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Solo i font usati sopra la piega -->
    <link rel="preload" href="/fonts/josefin-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/amalfi_coast-webfont.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={t.htmlLocale} />
    {alternates[lang === 'en' ? 'it' : 'en'] && <meta property="og:locale:alternate" content={ui[lang === 'en' ? 'it' : 'en'].htmlLocale} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-svh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-accent focus:px-4 focus:py-3 focus:text-sm focus:text-white"
    >
      {t.skip}
    </a>
    <Header alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Lightbox />
    <CookieBanner />

    <script>
      // Fade-in allo scroll per gli elementi .reveal
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
