---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import { baseSchema } from '../data/schema';
import defaultOgImage from '../assets/PORTFOLIO/Portfolio_Pandabrosproductions_0050.jpg';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Solo il Portfolio usa il tema chiaro */
  theme?: 'dark' | 'light';
  /** Immagine per la condivisione (Open Graph): di default la foto della hero */
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Dati strutturati aggiuntivi della pagina (JSON-LD) */
  schema?: object[];
  /** Lingua della pagina: l'inglese solo per i diari scritti in inglese */
  lang?: 'it' | 'en';
}

const {
  title,
  description = site.description,
  theme = 'dark',
  ogImage = defaultOgImage,
  ogImageAlt = 'Sposi che corrono mano nella mano su un prato al tramonto, davanti a una villa storica',
  ogType = 'website',
  schema = [],
  lang = 'it',
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 1200×630: il formato consigliato da Facebook, WhatsApp, LinkedIn e X
const ogUrl = async (src: ImageMetadata) =>
  new URL((await getImage({ src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 })).src, Astro.site).href;
const ogImageUrl = await ogUrl(ogImage);
// L'attività ha sempre la stessa immagine, qualunque sia la pagina
const jsonLd = [...baseSchema(Astro.site!, await ogUrl(defaultOgImage)), ...schema];
---

<!doctype html>
<html lang={lang} data-theme={theme === 'light' ? 'light' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      site.indexable ? (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      ) : (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <meta name="theme-color" content={theme === 'light' ? '#ffffff' : '#0b0b0c'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Solo i font usati sopra la piega -->
    <link rel="preload" href="/fonts/josefin-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/amalfi_coast-webfont.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'it_IT'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-svh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-accent focus:px-4 focus:py-3 focus:text-sm focus:text-white"
    >
      Vai al contenuto
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Lightbox />

    <script>
      // Fade-in allo scroll per gli elementi .reveal
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
