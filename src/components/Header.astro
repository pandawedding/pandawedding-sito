---
import Logo from './Logo.astro';
import { nav } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter,box-shadow] duration-500 data-[scrolled]:bg-bg/80 data-[scrolled]:shadow-[0_1px_0_var(--line)] data-[scrolled]:backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-screen-2xl items-center justify-between px-5 md:h-20 md:px-10">
    <a href="/" class="relative z-[60] -my-2 py-2 text-[1.375rem] md:text-[1.75rem]" aria-label="PandA Wedding, home">
      <Logo />
    </a>

    <nav class="hidden md:block" aria-label="Menu principale">
      <ul class="flex items-center gap-8 lg:gap-10">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.href ? 'page' : undefined}
                class="relative py-2 text-[0.8125rem] font-medium tracking-[0.18em] uppercase text-fg-muted transition-colors hover:text-fg aria-[current=page]:text-fg after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="relative z-[60] -mr-2 flex size-11 items-center justify-center md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Apri il menu"
    >
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<!-- Menu mobile a schermo intero: fuori dall'header, perché il backdrop-filter
     dell'header renderebbe `fixed` relativo all'header invece che allo schermo -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 flex flex-col bg-bg px-5 pt-24 pb-10 opacity-0 invisible transition-[opacity,visibility] duration-500 data-[open]:visible data-[open]:opacity-100 md:hidden"
  hidden
>
  <nav aria-label="Menu mobile" class="flex-1">
    <ul class="space-y-3">
      {
        nav.map((item, i) => (
          <li class="menu-item" style={`--i:${i}`}>
            <a
              href={item.href}
              aria-current={current === item.href ? 'page' : undefined}
              class="block py-2 text-[2.375rem] leading-none font-light tracking-[0.02em] uppercase text-fg aria-[current=page]:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="label">Italia e destinazioni</p>
</div>

<style>
  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--fg);
    transition:
      transform 0.35s var(--ease-out-soft),
      background-color 0.2s;
  }
  .menu-icon {
    position: relative;
  }
  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu-icon::before {
    transform: translateY(-7px);
  }
  .menu-icon::after {
    transform: translateY(7px);
  }
  [aria-expanded='true'] .menu-icon {
    background: transparent;
  }
  [aria-expanded='true'] .menu-icon::before {
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .menu-icon::after {
    transform: rotate(-45deg);
  }

  .menu-item {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s var(--ease-out-soft),
      transform 0.5s var(--ease-out-soft);
    transition-delay: calc(var(--i) * 60ms + 120ms);
  }
  [data-open] .menu-item {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!header || !toggle || !menu) return;

    // I listener globali vanno rimossi a ogni cambio pagina (ClientRouter)
    const ctrl = new AbortController();
    const { signal } = ctrl;
    document.addEventListener('astro:before-swap', () => {
      document.documentElement.style.overflow = '';
      ctrl.abort();
    }, { once: true });

    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true, signal });

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.toggleAttribute('data-open', true));
      } else {
        menu.removeAttribute('data-open');
        menu.addEventListener('transitionend', () => (menu.hidden = true), { once: true });
      }
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    }, { signal });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
