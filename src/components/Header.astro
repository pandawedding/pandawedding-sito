---
import Logo from './Logo.astro';
import { nav } from '../data/site';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 text-fg transition-[background-color,backdrop-filter,box-shadow,color] duration-500 data-[scrolled]:bg-bg/80 data-[scrolled]:shadow-[0_1px_0_var(--line)] data-[scrolled]:backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-screen-2xl items-center justify-between px-5 md:h-20 md:px-10">
    <a href="/#top" class="relative z-[60] -my-2 py-2 text-[1.375rem] md:text-[1.75rem]" aria-label="PandA Wedding, torna all'inizio">
      <Logo />
    </a>

    <nav class="hidden lg:block" aria-label="Menu principale">
      <ul class="flex items-center gap-8 lg:gap-10">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav={item.href.split('#')[1]}
                class="relative py-2 text-[0.8125rem] font-medium tracking-[0.18em] uppercase text-fg-muted transition-colors hover:text-fg aria-[current=true]:text-fg after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 hover:after:scale-x-100 aria-[current=true]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="relative z-[60] -mr-2 flex size-11 items-center justify-center lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Apri il menu"
    >
      <span class="menu-icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<!-- Menu mobile a schermo intero: fuori dall'header, perché il backdrop-filter
     dell'header renderebbe `fixed` relativo all'header invece che allo schermo -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 flex flex-col bg-bg px-5 pt-24 pb-10 opacity-0 invisible transition-[opacity,visibility] duration-500 data-[open]:visible data-[open]:opacity-100 lg:hidden"
  hidden
>
  <nav aria-label="Menu mobile" class="flex-1">
    <ul class="space-y-3">
      {
        nav.map((item, i) => (
          <li class="menu-item" style={`--i:${i}`}>
            <a
              href={item.href}
              data-nav={item.href.split('#')[1]}
              class="block py-2 text-[2.375rem] leading-none font-light tracking-[0.02em] uppercase text-fg aria-[current=true]:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="label">Italia e destinazioni</p>
</div>

<style>
  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 0.35s var(--ease-out-soft),
      background-color 0.2s;
  }
  .menu-icon {
    position: relative;
  }
  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu-icon::before {
    transform: translateY(-7px);
  }
  .menu-icon::after {
    transform: translateY(7px);
  }
  [aria-expanded='true'] .menu-icon {
    background: transparent;
  }
  [aria-expanded='true'] .menu-icon::before {
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .menu-icon::after {
    transform: rotate(-45deg);
  }

  .menu-item {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.5s var(--ease-out-soft),
      transform 0.5s var(--ease-out-soft);
    transition-delay: calc(var(--i) * 60ms + 120ms);
  }
  [data-open] .menu-item {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  // Sfondo sfumato dopo il primo scroll; tema chiaro quando l'header
  // passa sopra una sezione bianca (data-theme="light")
  const lightSections = [...document.querySelectorAll<HTMLElement>('main [data-theme="light"]')];
  const onScroll = () => {
    header.toggleAttribute('data-scrolled', window.scrollY > 8);
    const y = header.offsetHeight / 2;
    const overLight = lightSections.some((s) => {
      const r = s.getBoundingClientRect();
      return r.top <= y && r.bottom >= y;
    });
    if (overLight) header.dataset.theme = 'light';
    else delete header.dataset.theme;
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menu mobile
  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) {
      // Il menu è sempre scuro: l'header torna scuro mentre è aperto
      delete header.dataset.theme;
      menu.hidden = false;
      requestAnimationFrame(() => menu.toggleAttribute('data-open', true));
    } else {
      onScroll();
      menu.removeAttribute('data-open');
      menu.addEventListener('transitionend', () => (menu.hidden = true), { once: true });
    }
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Evidenzia nel menu la sezione corrente
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const sections = [...new Set([...links].map((l) => l.dataset.nav!))]
    .map((id) => document.getElementById(id))
    .filter((s): s is HTMLElement => !!s);
  if (sections.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.nav === entry.target.id)));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
