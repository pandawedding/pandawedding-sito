---
import WhatsAppLink from './WhatsAppLink.astro';
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import Photo from './Photo.astro';
import type { Diary } from '../data/diaries';
import { localePath, ui } from '../i18n';

// Testo e foto di un diario, nella sua pagina statica. Il pannello della landing
// carica questo stesso <article> dalla pagina solo quando viene aperto.
interface Props {
  diary: Diary;
}
const { diary } = Astro.props;
const { Content } = await render(diary.entry);
const { title, label } = diary.entry.data;
const { lang } = diary;
const ui_ = ui[lang];
const t = ui_.diary;
// Copertina verticale: intera, senza ritaglio, centrata e più stretta; orizzontale: 3:2 a tutta larghezza
const portraitCover = !!diary.cover && diary.cover.height > diary.cover.width;
---

<article class="mx-auto max-w-screen-lg px-5 md:px-10" data-lightbox-group data-diary-article>
  <header class="pt-6 md:pt-12">
    <p class="label">{label}</p>
    <h1 id="diary-title" class="mt-4 text-display font-light tracking-title uppercase">{title}</h1>
  </header>

  {
    portraitCover ? (
      <Photo
        src={diary.cover}
        alt={diary.coverAlt}
        ratio={`${diary.cover!.width} / ${diary.cover!.height}`}
        sizes="(min-width: 640px) 32rem, 100vw"
        widths={[640, 960, 1280]}
        class="mx-auto mt-10 max-w-lg md:mt-14"
      />
    ) : (
      <Photo
        src={diary.cover}
        alt={diary.coverAlt}
        ratio="3 / 2"
        sizes="(min-width: 1024px) 960px, 100vw"
        widths={[640, 960, 1280, 1600]}
        class="mt-10 md:mt-14"
      />
    )
  }

  <div class="prose-diary mx-auto mt-12 max-w-2xl md:mt-16">
    <Content />
  </div>

  {
    diary.photos.length > 1 && !diary.inlinePhotos && (
      <div class="mt-16 columns-2 gap-3 md:columns-3 md:gap-4">
        {diary.photos.slice(1).map((src, i) => (
          <button
            type="button"
            class="mb-3 block w-full break-inside-avoid md:mb-4"
            data-lightbox={i}
            data-full={src.src}
            data-alt={t.photoAlt(label, i + 2)}
            aria-label={t.enlarge(i + 2)}
          >
            <span class="photo block">
              <Picture
                src={src}
                alt={t.photoAlt(label, i + 2)}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[400, 640, 960]}
                sizes="(min-width: 768px) 32vw, 48vw"
                loading="lazy"
                class="block h-auto w-full"
              />
            </span>
          </button>
        ))}
      </div>
    )
  }

  <footer class="mx-auto mt-20 max-w-2xl border-t border-line pt-12 pb-20 text-center md:mt-28">
    <p class="label">{t.kicker}</p>
    <p class="mt-5 text-title font-light">{t.heading}</p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
      <a href={localePath(lang, '/#contatti')} class="btn" data-diary-cta data-track="cta_click" data-label={t.cta.toLowerCase()} data-position="diary">
        {t.cta} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <WhatsAppLink position="diary" />
    </div>
    <a href={localePath(lang, '/#about')} class="cta-link mt-4" data-diary-cta data-track="cta_click" data-label="our approach" data-position="diary">
      {ui_.cta.approach} <span class="chevron" aria-hidden="true">›</span>
    </a>
  </footer>
</article>

<script>
  import { prepareDiaryPhotos } from '../scripts/diary-photos';
  prepareDiaryPhotos(document);
</script>
