---
import WhatsAppLink from './WhatsAppLink.astro';
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import Photo from './Photo.astro';
import type { Diary } from '../data/diaries';

// Testo e foto di un diario: usato sia nel pannello della landing sia nella pagina statica
interface Props {
  diary: Diary;
  /** id del titolo, per aria-labelledby */
  titleId: string;
  /** h1 nella pagina statica, h2 nel pannello della landing */
  headingLevel?: 1 | 2;
}
const { diary, titleId, headingLevel = 2 } = Astro.props;
const { Content } = await render(diary.entry);
const { couple, title, label } = diary.entry.data;
const Heading = `h${headingLevel}`;
---

<article class="mx-auto max-w-screen-lg px-5 md:px-10" data-lightbox-group>
  <header class="pt-6 md:pt-12">
    <p class="label">{label}</p>
    <Heading id={titleId} class="mt-4 text-display font-light tracking-title uppercase">{title}</Heading>
  </header>

  <Photo
    src={diary.cover}
    alt={`${couple}, ${label}`}
    ratio="3 / 2"
    sizes="(min-width: 1024px) 960px, 100vw"
    widths={[640, 960, 1280, 1600]}
    class="mt-10 md:mt-14"
  />

  <div class="prose-diary mx-auto mt-12 max-w-2xl md:mt-16">
    <Content />
  </div>

  {
    diary.photos.length > 1 && !diary.inlinePhotos && (
      <div class="mt-16 columns-2 gap-3 md:columns-3 md:gap-4">
        {diary.photos.slice(1).map((src, i) => (
          <button
            type="button"
            class="mb-3 block w-full break-inside-avoid md:mb-4"
            data-lightbox={i}
            data-full={src.src}
            data-alt={`${couple}, foto ${i + 2}`}
            aria-label={`Ingrandisci la foto ${i + 2} di ${couple}`}
          >
            <span class="photo block">
              <Picture
                src={src}
                alt={`${couple}, foto ${i + 2}`}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[400, 640, 960]}
                sizes="(min-width: 768px) 32vw, 48vw"
                loading="lazy"
                class="block h-auto w-full"
              />
            </span>
          </button>
        ))}
      </div>
    )
  }

  <footer class="mx-auto mt-20 max-w-2xl border-t border-line pt-12 pb-20 text-center md:mt-28">
    <p class="label">Il vostro diario</p>
    <p class="mt-5 text-title font-light">Il tuo matrimonio merita di essere raccontato così</p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href="/#contatti" class="btn" data-diary-cta data-track="cta_click" data-label="raccontaci la tua storia" data-position="diary">
        Raccontaci la tua storia <span class="arrow" aria-hidden="true">→</span>
      </a>
      <WhatsAppLink position="diary" />
    </div>
    <a href="/#about" class="cta-link mt-4" data-diary-cta data-track="cta_click" data-label="our approach" data-position="diary">
      Our approach <span class="chevron" aria-hidden="true">›</span>
    </a>
  </footer>
</article>

<script>
  // Le foto scritte nel Markdown del diario si aprono nel visore come le altre
  document.querySelectorAll<HTMLImageElement>('.prose-diary img').forEach((img, i) => {
    img.dataset.lightbox = String(i);
    img.dataset.full = img.currentSrc || img.src;
    img.dataset.alt = img.alt;
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        img.click();
      }
    });
  });
</script>
