---
import { legalPath } from '../data/legal';
import { getLang, ui } from '../i18n';

// Banner del consenso: "Accetta" e "Rifiuta" con la stessa evidenza.
// Compare alla prima visita e si riapre con i link [data-cookie-settings] (footer, cookie policy).
const lang = getLang(Astro.currentLocale);
const t = ui[lang].consent;
---

<div
  id="cookie-banner"
  class="fixed inset-x-3 bottom-3 z-[60] mx-auto max-w-xl rounded-xl border border-line bg-bg-raised p-5 text-fg shadow-2xl md:bottom-6 md:p-6"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-text"
  hidden
>
  <p id="cookie-title" class="label">{t.title}</p>
  <p id="cookie-text" class="mt-3 text-sm leading-relaxed font-light text-fg-muted">
    {t.text}{" "}
    <a href={legalPath.cookies[lang]} class="text-fg underline underline-offset-2">{t.policy}</a>.
  </p>
  <div class="mt-5 grid grid-cols-2 gap-3">
    <button type="button" class="btn btn-ghost justify-center" data-consent="denied">{t.reject}</button>
    <button type="button" class="btn btn-ghost justify-center" data-consent="granted">{t.accept}</button>
  </div>
</div>

<script>
  import { getConsent, setConsent } from '../scripts/analytics';

  const banner = document.getElementById('cookie-banner')!;
  const open = () => (banner.hidden = false);
  if (!getConsent()) open();

  banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => {
      setConsent(b.dataset.consent as 'granted' | 'denied');
      banner.hidden = true;
    }),
  );
  document.querySelectorAll('[data-cookie-settings]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      open();
      banner.querySelector<HTMLButtonElement>('[data-consent]')?.focus();
    }),
  );
</script>
