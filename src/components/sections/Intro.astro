---
import Photo from '../Photo.astro';
import team from '../../assets/team/pierluigi-alberto.jpg';
import { t as tr } from '../../i18n';

const t = tr(Astro.currentLocale);
---

<!-- Presentazione: Pierluigi e Alberto -->
<section class="mx-auto max-w-screen-xl overflow-x-clip px-5 pt-24 pb-12 md:px-10 md:pt-40 md:pb-16" aria-labelledby="intro-title">
  <div class="grid items-center gap-12 md:grid-cols-2 md:gap-16">
    <!-- Titolo verticale su una riga, fuori dalla foto nel margine destro, centrato sulla sua altezza.
         Due livelli allineati: il testo chiaro e, sopra, solo la P e la A in rosso nel corsivo del logo. -->
    <div class="intro-photo reveal relative md:order-last">
      <Photo
        src={team}
        alt={t.intro.alt}
        ratio="2 / 3"
        sizes="(min-width: 768px) 40vw, 85vw"
      />
      <h2 id="intro-title" class="intro-title intro-title--text">
        {t.intro.we}{" "}
        <span class="script">P</span>ierluigi {t.intro.and} <span class="script">A</span>lberto
      </h2>
      <p class="intro-title intro-title--accent" aria-hidden="true">
        {t.intro.we}{" "}
        <span class="script">P</span>ierluigi {t.intro.and} <span class="script">A</span>lberto
      </p>
    </div>

    <div class="reveal max-w-md">
      <p class="text-lead font-medium">{t.intro.lead}</p>
      <p class="mt-6 text-lead font-light text-fg-muted">
        {t.intro.text}
      </p>
      <a href="#about" class="btn mt-10" data-track="cta_click" data-label="our approach" data-position="intro">
        {t.cta.approach} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .intro-title {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(100% - var(--gutter) + 0.75rem);
    z-index: 10;
    text-align: center;
    writing-mode: vertical-rl;
    white-space: nowrap;
    /* Cresce con la larghezza della foto, così la riga resta sempre dentro la sua altezza */
    font-size: clamp(1rem, 6cqw, 1.75rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
  }
  @supports (writing-mode: sideways-lr) {
    .intro-title {
      writing-mode: sideways-lr;
    }
  }
  @supports not (writing-mode: sideways-lr) {
    .intro-title {
      transform: rotate(180deg);
    }
  }
  .intro-photo {
    container-type: inline-size;
    --gutter: 2.75rem;
    padding-right: var(--gutter);
  }
  @media (min-width: 768px) {
    .intro-photo {
      --gutter: 3.5rem;
    }
  }
  .intro-title--text {
    color: var(--fg);
  }
  .intro-title--text .script,
  .intro-title--accent {
    color: transparent;
  }
  .intro-title--accent .script {
    color: var(--accent);
  }
  .script {
    font-family: var(--font-script);
    font-size: 1.4em;
    font-weight: 400;
    line-height: 0;
    letter-spacing: 0;
    text-transform: none;
  }
</style>
