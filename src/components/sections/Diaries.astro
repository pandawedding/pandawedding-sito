---
import WhatsAppLink from '../WhatsAppLink.astro';
import BrochureLink from '../BrochureLink.astro';
import Photo from '../Photo.astro';
import { getDiaries } from '../../data/diaries';
import { getLang, localePath, ui } from '../../i18n';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];

const diaries = await getDiaries(lang);
const diaryPath = (slug: string) => localePath(lang, `/real-weddings/${slug}/`);
// Storie mostrate subito
const VISIBLE = 3;
---

<!-- Pages: i Real Weddings. Il diario si apre in un pannello sopra la pagina -->
<section
  id="real-weddings"
  class="fade-from-light bg-bg pt-16 pb-20 md:pt-24 md:pb-28"
  aria-labelledby="diaries-title"
  data-diary-hash={t.diaries.hash}
>
  <header class="reveal mx-auto max-w-screen-2xl px-5 text-center md:px-10">
    <p class="label">Real Weddings</p>
    <h2 id="diaries-title" class="mt-4 text-display font-light tracking-title">
      <span class="text-accent">Pa</span>ges
    </h2>
    <p class="mt-6 text-lead font-light text-fg-muted">
      {t.diaries.lead[0]}<br />
      {t.diaries.lead[1]}<br />
      <span class="text-fg">{t.diaries.lead[2]}</span>
    </p>
  </header>

  <!-- Storie centrate; oltre le prime VISIBLE si aprono con "Vedi altre storie".
       Sul telefono sono una riga orizzontale da scorrere (stile Netflix), per non allungare la pagina -->
  <ul
    class="stories mx-auto mt-12 flex max-w-screen-2xl gap-x-4 px-5 max-md:snap-x max-md:snap-mandatory max-md:overflow-x-auto max-md:overscroll-x-contain md:mt-16 md:flex-wrap md:justify-center md:gap-x-5 md:gap-y-16 md:px-10"
    aria-label={t.diaries.rowLabel}
    data-row="real-weddings"
  >
    {
      diaries.map((diary, i) => (
        <li
          class="reveal w-[82%] max-w-[26rem] shrink-0 snap-start text-center md:w-[calc((100%-2.5rem)/3)]"
          hidden={i >= VISIBLE}
          data-story
        >
          {diary.hasStory ? (
            // Anche la copertina apre il diario; per i lettori di schermo basta il link testuale sotto
            <a href={diaryPath(diary.slug)} data-diary={diary.slug} class="cover-link block" tabindex="-1" aria-hidden="true">
              <Photo
                src={diary.cover}
                alt={`${diary.entry.data.couple}, ${diary.entry.data.label}`}
                ratio="4 / 5"
                sizes="(min-width: 768px) 30vw, 90vw"
              />
            </a>
          ) : (
            <Photo
              src={diary.cover}
              alt={`${diary.entry.data.couple}, ${diary.entry.data.label}`}
              ratio="4 / 5"
              sizes="(min-width: 768px) 30vw, 90vw"
            />
          )}
          <p class="label mt-6">{diary.entry.data.label}</p>
          <h3 class="mt-3 text-title font-light">{diary.entry.data.title}</h3>
          <p class="mt-3 leading-relaxed font-light text-fg-muted">{diary.entry.data.excerpt}</p>
          <div class="mt-4 flex flex-wrap justify-center gap-x-6">
            {diary.hasStory && (
              <a href={diaryPath(diary.slug)} data-diary={diary.slug} class="cta-link">
                {t.cta.readDiary} <span class="chevron" aria-hidden="true">›</span>
              </a>
            )}
            {diary.entry.data.film && (
              <button type="button" data-film={diary.entry.data.film} class="cta-link">
                {t.cta.trailer} <span class="chevron" aria-hidden="true">›</span>
              </button>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  {
    diaries.length > VISIBLE && (
      <div class="mt-14 flex justify-center">
        <button type="button" id="stories-more" class="btn btn-ghost">
          {t.diaries.more} <span class="text-fg-muted">({diaries.length - VISIBLE})</span>
        </button>
      </div>
    )
  }

  <div class="reveal mx-auto mt-24 max-w-screen-2xl px-5 text-center md:mt-36 md:px-10">
    <p class="text-title font-light tracking-title uppercase">
      {t.diaries.newPage[0]} <span class="text-accent">{t.diaries.newPage[1]}</span>
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
      <a href="#contatti" class="btn" data-track="cta_click" data-label="get in touch" data-position="diaries">
        {t.cta.getInTouch} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <WhatsAppLink position="diaries" />
    </div>
    <BrochureLink position="diaries" class="mt-5" />
  </div>
</section>

<!-- Pannelli dei diari: vuoti nella landing, il testo arriva dalla pagina statica all'apertura
     (così Google non trova il diario due volte e la landing resta leggera) -->
{
  diaries
    .filter((d) => d.hasStory)
    .map((diary) => (
      <dialog
        class="diary-panel m-0 h-dvh max-h-none w-screen max-w-none overflow-y-auto overscroll-contain bg-bg p-0 text-fg"
        data-diary-panel={diary.slug}
        data-diary-url={diaryPath(diary.slug)}
        aria-label={diary.entry.data.title}
      >
        <div class="sticky top-0 z-10 flex justify-end bg-gradient-to-b from-bg to-transparent px-5 py-4 md:px-10">
          <button
            type="button"
            data-diary-close
            class="flex size-11 items-center justify-center rounded-full bg-bg-raised text-xl transition-colors hover:bg-accent hover:text-white"
            aria-label={t.diaries.close}
          >
            ✕
          </button>
        </div>
        <div data-diary-body>
          <p class="label py-32 text-center text-fg-muted" role="status">{t.diaries.loading}</p>
        </div>
      </dialog>
    ))
}

<style>
  .cover-link :global(img) {
    transition: transform 0.7s var(--ease-out-soft, ease-out);
  }
  @media (hover: hover) {
    .cover-link:hover :global(img) {
      transform: scale(1.03);
    }
  }
  .stories {
    scrollbar-width: none;
    scroll-padding-inline: 1.25rem;
  }
  .stories::-webkit-scrollbar {
    display: none;
  }
  .diary-panel[open] {
    animation: panel-in 0.6s var(--ease-out-soft);
  }
  .diary-panel::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  @keyframes panel-in {
    from {
      transform: translateY(6%);
      opacity: 0;
    }
  }
</style>

<script>
  import { prepareDiaryPhotos } from '../../scripts/diary-photos';
  import { lockScroll, unlockScroll } from '../../scripts/modal';

  // Apertura dei diari nel pannello, con link condivisibile #diary/<slug> (#diario/<slug> in italiano).
  // Il tasto indietro chiude il pannello; senza JS il link porta alla pagina statica.
  const HASH = document.getElementById('real-weddings')?.dataset.diaryHash ?? '#diary/';
  // Accetta anche i link condivisi dall'altra lingua
  const diaryHash = () => location.hash.match(/^#diar(?:y|io)\/(.+)$/)?.[1];
  const panel = (slug: string) => document.querySelector<HTMLDialogElement>(`[data-diary-panel="${slug}"]`);
  let pushed = false;

  // Il diario si carica dalla sua pagina statica alla prima apertura
  const load = async (dialog: HTMLDialogElement, slug: string) => {
    if (dialog.dataset.loaded) return;
    dialog.dataset.loaded = 'true';
    try {
      const res = await fetch(dialog.dataset.diaryUrl!);
      if (!res.ok) throw new Error(String(res.status));
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      const article = doc.querySelector<HTMLElement>('[data-diary-article]');
      if (!article) throw new Error('article not found');
      dialog.querySelector('[data-diary-body]')!.replaceChildren(document.adoptNode(article));
      prepareDiaryPhotos(article);
      // CTA del diario: chiude il pannello e scende alla sezione del link
      article.querySelectorAll<HTMLAnchorElement>('[data-diary-cta]').forEach((link) =>
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById(link.hash.slice(1));
          dialog.close();
          setTimeout(() => target?.scrollIntoView({ behavior: 'smooth' }), 300);
        }),
      );
    } catch {
      // Senza rete o con un errore: si apre la pagina statica del diario
      location.href = dialog.dataset.diaryUrl!;
    }
  };

  const open = (slug: string, push: boolean) => {
    const dialog = panel(slug);
    if (!dialog || dialog.open) return;
    load(dialog, slug);
    if (push) {
      history.pushState({ diary: slug }, '', HASH + slug);
      pushed = true;
    }
    dialog.showModal();
    dialog.scrollTop = 0;
    lockScroll();
    document.dispatchEvent(new CustomEvent('diary_open', { detail: { slug } }));
  };

  const closeAll = () => {
    document.querySelectorAll<HTMLDialogElement>('[data-diary-panel][open]').forEach((d) => d.close());
  };

  document.querySelectorAll<HTMLDialogElement>('[data-diary-panel]').forEach((dialog) => {
    dialog.addEventListener('close', () => {
      unlockScroll();
      if (diaryHash()) {
        if (pushed) history.back();
        else history.replaceState(null, '', location.pathname + location.search);
      }
      pushed = false;
    });
    dialog.querySelector('[data-diary-close]')?.addEventListener('click', () => dialog.close());
  });

  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-diary]');
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    open(link.dataset.diary!, true);
  });

  window.addEventListener('popstate', () => {
    if (diaryHash()) open(diaryHash()!, false);
    else {
      pushed = false;
      closeAll();
    }
  });

  if (diaryHash()) open(diaryHash()!, false);

  // "Vedi altre storie": compare solo quando le storie superano quelle mostrate subito
  document.getElementById('stories-more')?.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLElement>('[data-story][hidden]').forEach((el) => (el.hidden = false));
    (e.currentTarget as HTMLElement).parentElement!.hidden = true;
  });
</script>
