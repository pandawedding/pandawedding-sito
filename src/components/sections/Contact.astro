---
import WhatsAppLink from '../WhatsAppLink.astro';
import { site } from '../../data/site';
import { legalPath } from '../../data/legal';
import { getLang, t as tr } from '../../i18n';

// Etichette e placeholder dal sito Framer (pagina Contatti), nella lingua della pagina
const t = tr(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);
const f = t.contact.fields;
const fields = [
  { name: 'names', label: f.names[0], placeholder: f.names[1], type: 'text', required: true, autocomplete: 'name' },
  { name: 'email', label: f.email[0], placeholder: f.email[1], type: 'email', required: true, autocomplete: 'email' },
  { name: 'date', label: f.date[0], placeholder: f.date[1], type: 'text', required: false, autocomplete: 'off' },
  { name: 'venue', label: f.venue[0], placeholder: f.venue[1], type: 'text', required: true, autocomplete: 'off' },
  { name: 'phone', label: f.phone[0], placeholder: f.phone[1], type: 'tel', required: false, autocomplete: 'tel' },
  { name: 'planner', label: f.planner[0], placeholder: f.planner[1], type: 'text', required: false, autocomplete: 'off' },
];
---

<!-- Sezione chiara come il Portfolio: sfondo bianco, testi scuri e rossi -->
<section
  id="contatti"
  data-theme="light"
  class="fade-from-dark bg-bg py-24 text-fg md:py-40"
  aria-labelledby="contact-title"
>
  <div class="mx-auto grid max-w-screen-2xl gap-16 px-5 md:grid-cols-[1fr_1.1fr] md:gap-20 md:px-10">
    <!-- Da tablet in su resta in vista mentre si scorrono form e brochure -->
    <div class="reveal md:sticky md:top-28 md:self-start">
      <p class="label">{t.contact.kicker}</p>
      <h2 id="contact-title" class="mt-4 text-title font-light">
        {t.contact.title[0]} <span class="text-accent">{t.contact.title[1]}</span>
      </h2>
      <p class="mt-6 text-lead font-light text-fg-muted">{t.contact.lead}</p>

      <div class="mt-12 flex flex-col items-start gap-8">
        <a
          href={`mailto:${site.email}`}
          data-track="click_email"
          class="text-xl font-light break-all underline decoration-accent decoration-1 underline-offset-8 transition-colors hover:text-accent md:text-2xl"
        >
          {site.email}
        </a>
        <WhatsAppLink position="contact" />
      </div>
    </div>

    <div class="min-w-0">
      <form
        id="contact-form"
        class="reveal grid gap-x-5 gap-y-6 sm:grid-cols-2 md:grid-cols-1 xl:grid-cols-2"
        novalidate
        data-msg-required={t.contact.required}
        data-msg-sending={t.contact.sending}
        data-msg-sent={t.contact.sent}
        data-msg-failed={t.contact.failed(site.email)}
      >
        {
          fields.map((field) => (
            <label class="flex flex-col gap-2">
              <span class="text-[0.6875rem] font-semibold tracking-[0.2em] text-fg-muted uppercase">
                {field.label}
                {field.required && <span class="text-accent"> *</span>}
              </span>
              <input
                name={field.name}
                type={field.type}
                required={field.required}
                placeholder={field.placeholder}
                autocomplete={field.autocomplete}
                class="field"
              />
            </label>
          ))
        }
        <label class="flex flex-col gap-2 sm:col-span-2 md:col-span-1 xl:col-span-2">
          <span class="text-[0.6875rem] font-semibold tracking-[0.2em] text-fg-muted uppercase">
            {f.message[0]} <span class="text-accent">*</span>
          </span>
          <textarea
            name="message"
            required
            rows="5"
            placeholder={f.message[1]}
            class="field resize-y"></textarea>
        </label>

        <!-- Honeypot antispam: invisibile alle persone -->
        <label class="absolute -left-[9999px]" aria-hidden="true">
          Company <input name="company" type='text' tabindex="-1" autocomplete='off' />
        </label>

        <div class="flex flex-col items-start gap-4 sm:col-span-2 md:col-span-1 xl:col-span-2">
          <p class="text-xs text-fg-muted">
            {t.contact.privacy[0]}
            <a href={legalPath.privacy[lang]} class="underline underline-offset-2 hover:text-fg">{t.contact.privacy[1]}</a>.
          </p>
          <button type="submit" class="btn">
            {t.contact.submit} <span class="arrow" aria-hidden="true">→</span>
          </button>
          <p data-form-status class="text-sm" role="status" aria-live="polite"></p>
        </div>
      </form>

      <!-- Brochure: dopo il form, per chi non è ancora pronto a scrivere; basta l'email -->
      <form
        id="brochure"
        class="reveal mt-14 scroll-mt-28 rounded-[6px] bg-bg-raised p-6 md:p-8"
        novalidate
        data-msg-sending={t.contact.sending}
        data-msg-sent={t.brochure.sent}
        data-msg-failed={t.contact.failed(site.email)}
        aria-labelledby="brochure-title"
      >
        <p class="label">{t.brochure.kicker}</p>
        <h3 id="brochure-title" class="mt-3 text-xl font-light md:text-2xl">
          {t.brochure.title[0]} <span class="text-accent">{t.brochure.title[1]}</span>
        </h3>
        <p class="mt-3 leading-relaxed font-light text-fg-muted">{t.brochure.text}</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row md:flex-col xl:flex-row">
          <label class="flex-1">
            <span class="sr-only">Email</span>
            <input
              name="email"
              type="email"
              required
              placeholder={t.contact.fields.email[1]}
              autocomplete="email"
              class="field"
            />
          </label>
          <!-- Honeypot antispam: invisibile alle persone -->
          <label class="absolute -left-[9999px]" aria-hidden="true">
            Company <input name="company" type="text" tabindex="-1" autocomplete="off" />
          </label>
          <button type="submit" class="btn btn-ghost justify-center" data-track="cta_click" data-label="brochure" data-position="contact">
            {t.brochure.submit} <span class="arrow" aria-hidden="true">→</span>
          </button>
        </div>
        <p class="mt-3 text-xs text-fg-muted">{t.brochure.privacy}</p>
        <p data-form-status class="mt-2 text-sm" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<!-- Chiusura dopo i contatti, prima del footer -->
<section data-sticky-end class="fade-from-light bg-bg flex min-h-[50svh] items-center justify-center px-5 py-24" aria-label={t.contact.outroLabel}>
  <p class="reveal text-center text-display font-light tracking-title uppercase">
    {t.contact.outro[0]}<br />{t.contact.outro[1]}<br /><span class="text-accent">{t.contact.outro[2]}</span>
  </p>
</section>

<style>
  .field {
    width: 100%;
    min-height: 3rem;
    padding: 0.85rem 1rem 0.7rem;
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 1rem; /* evita lo zoom automatico su iOS */
    transition: box-shadow 0.2s;
  }
  /* Sul bianco il bordo standard quasi sparisce: più marcato (~3:1) */
  :global([data-theme='light']) .field {
    box-shadow: inset 0 0 0 1px rgb(23 21 19 / 0.45);
  }
  .field::placeholder {
    color: var(--fg-muted);
    opacity: 0.8; /* ~5:1 sullo sfondo del campo */
  }
  .field:focus {
    outline: none;
    box-shadow: inset 0 0 0 1px var(--accent);
  }
  .field[aria-invalid='true'] {
    box-shadow: inset 0 0 0 1px var(--accent);
  }
</style>

<script>

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = form.querySelector<HTMLElement>('[data-form-status]')!;
  let started = false;

  form.addEventListener('input', () => {
    if (started) return;
    started = true;
    document.dispatchEvent(new CustomEvent('contact_form_start'));
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    let firstInvalid: HTMLElement | null = null;
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[required], textarea[required]').forEach((el) => {
      const ok = el.checkValidity();
      el.setAttribute('aria-invalid', String(!ok));
      if (!ok && !firstInvalid) firstInvalid = el;
    });
    if (firstInvalid) {
      status.textContent = form.dataset.msgRequired!;
      (firstInvalid as HTMLElement).focus();
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    status.textContent = form.dataset.msgSending!;
    try {
      // TODO: endpoint serverless (Resend) ancora da creare
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'inquiry', lang: document.documentElement.lang, ...Object.fromEntries(new FormData(form)) }),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = form.dataset.msgSent!;
      document.dispatchEvent(new CustomEvent('contact_form_submit'));
    } catch {
      status.textContent = form.dataset.msgFailed!;
    } finally {
      button.disabled = false;
    }
  });

  // Richiesta brochure: solo l'email, stesso endpoint dei contatti con type "brochure"
  const brochure = document.getElementById('brochure') as HTMLFormElement;
  const brochureStatus = brochure.querySelector<HTMLElement>('[data-form-status]')!;
  brochure.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = brochure.querySelector<HTMLInputElement>('input[name="email"]')!;
    email.setAttribute('aria-invalid', String(!email.checkValidity()));
    if (!email.checkValidity()) {
      email.focus();
      return;
    }
    const button = brochure.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    brochureStatus.textContent = brochure.dataset.msgSending!;
    try {
      // TODO: endpoint serverless (Resend) ancora da creare: avvisa i titolari, che mandano la brochure di persona
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'brochure', lang: document.documentElement.lang, ...Object.fromEntries(new FormData(brochure)) }),
      });
      if (!res.ok) throw new Error(String(res.status));
      brochure.reset();
      brochureStatus.textContent = brochure.dataset.msgSent!;
      document.dispatchEvent(new CustomEvent('brochure_request'));
    } catch {
      brochureStatus.textContent = brochure.dataset.msgFailed!;
    } finally {
      button.disabled = false;
    }
  });
</script>
