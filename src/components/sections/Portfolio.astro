---
import WhatsAppLink from '../WhatsAppLink.astro';
import BrochureLink from '../BrochureLink.astro';
import { Picture, getImage } from 'astro:assets';
import { portfolio, PORTFOLIO_FIRST } from '../../data/portfolio';
import { getLang, ui } from '../../i18n';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];

// Prima la selezione, poi blocchi da 18 aperti con "Vedi altre foto".
// Ogni blocco ha la sua griglia: aprirne uno non sposta le foto già viste.
const BATCH = 18;
// Sul telefono la selezione è più corta: le altre foto della selezione arrivano con il primo "Vedi altre foto"
const MOBILE_FIRST = 5;

// Impaginazione editoriale: dimensioni e posizioni sfalsate che si ripetono ogni 9 foto.
// Ogni riga ha una o due foto; una colonna di partenza più a sinistra manda a capo.
const layout = [
  'col-start-1 col-span-5 md:col-start-1 md:col-span-6',
  'col-start-2 col-span-5 md:col-start-8 md:col-span-4 md:mt-40',
  'col-start-1 col-span-3 md:col-start-2 md:col-span-3',
  'col-start-4 col-span-3 mt-16 md:col-start-6 md:col-span-6 md:mt-24',
  'col-start-1 col-span-6 md:col-start-1 md:col-span-4 md:mt-12',
  'col-start-2 col-span-4 md:col-start-7 md:col-span-3 md:mt-48',
  'col-start-1 col-span-3 md:col-start-3 md:col-span-7',
  'col-start-4 col-span-3 mt-12 md:col-start-1 md:col-span-3 md:mt-20',
  'col-start-2 col-span-5 md:col-start-6 md:col-span-5',
];
const photos = await Promise.all(
  portfolio.map(async (p, index) => ({
    ...p,
    alt: p.alt[lang],
    index,
    full: (await getImage({ src: p.src, width: 1600, format: 'webp' })).src,
  })),
);
const batches = [photos.slice(0, PORTFOLIO_FIRST)];
for (let i = PORTFOLIO_FIRST; i < photos.length; i += BATCH) batches.push(photos.slice(i, i + BATCH));
---

<!-- Inspirations: unica sezione chiara del sito -->
<section
  id="portfolio"
  data-theme="light"
  data-lightbox-group
  class="fade-from-dark bg-bg pt-20 pb-20 text-fg md:pt-32 md:pb-28"
  aria-labelledby="portfolio-title"
>
  <header class="reveal mx-auto max-w-screen-2xl px-5 text-center md:px-10">
    <p class="label">{t.portfolio.kicker}</p>
    <h2 id="portfolio-title" class="mt-4 text-display font-light tracking-title">
      Insp<span class="text-accent">i</span>rations
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lead font-light text-fg-muted">
      {t.portfolio.text}
    </p>
  </header>

  <div class="mx-auto mt-16 max-w-5xl px-5 md:mt-28 md:px-10">
    {
      batches.map((batch, b) => (
        <div
          class="portfolio-batch grid grid-cols-6 items-start gap-x-4 gap-y-12 md:grid-cols-12 md:gap-x-8 md:gap-y-24 [&+&]:mt-12 md:[&+&]:mt-24"
          data-batch={b}
          hidden={b > 0}
        >
          {batch.map((photo, i) => (
            <button
              type="button"
              class:list={['group block w-full', layout[i % layout.length], b === 0 && i >= MOBILE_FIRST && 'mobile-extra max-md:hidden']}
              data-lightbox={photo.index}
              data-full={photo.full}
              data-alt={photo.alt}
              aria-label={`${t.portfolio.enlarge}: ${photo.alt}`}
            >
              <span class="photo block shadow-[0_0_0_1px_var(--line)]">
                <Picture
                  src={photo.src}
                  alt={photo.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[480, 720, 1000]}
                  sizes="(min-width: 1024px) 520px, (min-width: 768px) 50vw, 85vw"
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
                />
              </span>
            </button>
          ))}
        </div>
      ))
    }

    <div class="mt-20 flex justify-center md:mt-28">
      <button
        type="button"
        id="portfolio-more"
        class="btn btn-ghost"
        data-remaining={photos.length - PORTFOLIO_FIRST}
        data-mobile-extra={PORTFOLIO_FIRST - MOBILE_FIRST}
      >
        {t.portfolio.more} <span class="text-fg-muted" data-count>({photos.length - PORTFOLIO_FIRST})</span>
      </button>
    </div>
  </div>

  <div class="reveal mx-auto mt-24 max-w-screen-2xl px-5 text-center md:mt-36 md:px-10">
    <h3 class="text-title font-light tracking-title uppercase">
      {t.portfolio.next[0]} <span class="text-accent">{t.portfolio.next[1]}</span>
    </h3>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-2 sm:gap-3">
      <a href="#contatti" class="btn" data-track="cta_click" data-label="get in touch" data-position="portfolio">
        {t.cta.getInTouch} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <WhatsAppLink position="portfolio" />
    </div>
    <BrochureLink position="portfolio" class="mt-5" />
  </div>
</section>

<script>
  const more = document.getElementById('portfolio-more') as HTMLButtonElement;
  const count = more.querySelector('[data-count]')!;
  let remaining = Number(more.dataset.remaining);
  const mobile = window.matchMedia('(max-width: 767px)');
  const extras = () => document.querySelectorAll<HTMLElement>('#portfolio .mobile-extra');
  const showCount = () => (count.textContent = `(${remaining + (mobile.matches ? extras().length : 0)})`);
  showCount();
  mobile.addEventListener('change', showCount);

  more.addEventListener('click', () => {
    // Telefono: prima le foto della selezione nascoste
    if (mobile.matches && extras().length) {
      extras().forEach((el) => el.classList.remove('mobile-extra', 'max-md:hidden'));
      showCount();
      return;
    }
    const next = document.querySelector<HTMLElement>('.portfolio-batch[hidden]');
    if (!next) return;
    next.hidden = false;
    remaining -= next.querySelectorAll('[data-lightbox]').length;
    showCount();
    if (!document.querySelector('.portfolio-batch[hidden]')) more.parentElement!.hidden = true;
  });
</script>
