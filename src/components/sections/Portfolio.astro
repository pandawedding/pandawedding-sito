---
import WhatsAppLink from '../WhatsAppLink.astro';
import BrochureLink from '../BrochureLink.astro';
import { Picture, getImage } from 'astro:assets';
import { portfolio, PORTFOLIO_FIRST } from '../../data/portfolio';
import { getLang, ui } from '../../i18n';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];

// Prima la selezione, poi blocchi da 18 aperti con "Vedi altre foto".
// Ogni blocco ha la sua griglia: aprirne uno non sposta le foto già viste.
const BATCH = 18;
// Sul telefono la selezione è più corta: le altre foto della selezione arrivano con il primo "Vedi altre foto"
const MOBILE_FIRST = 5;

// Impaginazione editoriale. Le foto orizzontali sono centrate e prendono una riga tutta per loro;
// le verticali danno il movimento: dimensioni e posizioni sfalsate che si ripetono ogni 9 verticali.
// Su desktop le verticali stanno a coppie (una colonna di partenza più a sinistra manda a capo), sul telefono una per riga.
const layout = [
  'col-start-1 col-span-5 md:col-start-1 md:col-span-5',
  'col-start-2 col-span-5 md:col-start-8 md:col-span-4 md:mt-24',
  'col-start-1 col-span-5 md:col-start-2 md:col-span-4',
  'col-start-2 col-span-5 md:col-start-8 md:col-span-5 md:mt-16',
  'col-start-1 col-span-5 md:col-start-1 md:col-span-4 md:mt-8',
  'col-start-2 col-span-5 md:col-start-7 md:col-span-4 md:mt-32',
  'col-start-1 col-span-5 md:col-start-4 md:col-span-5',
  'col-start-2 col-span-5 md:col-start-2 md:col-span-4 md:mt-6',
  'col-start-1 col-span-5 md:col-start-7 md:col-span-5 md:mt-20',
];
const wide = 'col-start-1 col-span-6 md:col-start-2 md:col-span-10';
const photos = await Promise.all(
  portfolio.map(async (p, index) => ({
    ...p,
    alt: p.alt[lang],
    index,
    landscape: p.src.width > p.src.height,
    full: (await getImage({ src: p.src, width: 1600, format: 'webp' })).src,
  })),
);
const batches = [photos.slice(0, PORTFOLIO_FIRST)];
for (let i = PORTFOLIO_FIRST; i < photos.length; i += BATCH) batches.push(photos.slice(i, i + BATCH));
// Posizione di ogni foto: le verticali seguono lo schema contando solo le verticali del blocco
const slots = batches.map((batch) => {
  let portrait = 0;
  return batch.map((p) => (p.landscape ? wide : layout[portrait++ % layout.length]));
});
---

<!-- Inspirations: unica sezione chiara del sito -->
<section
  id="portfolio"
  data-theme="light"
  data-lightbox-group
  class="fade-from-dark bg-bg pt-20 pb-20 text-fg md:pt-32 md:pb-28"
  aria-labelledby="portfolio-title"
>
  <header class="reveal mx-auto max-w-screen-2xl px-5 text-center md:px-10">
    <p class="label">{t.portfolio.kicker}</p>
    <h2 id="portfolio-title" class="mt-4 text-display font-light tracking-title">
      Ins<span class="text-accent">p</span>ir<span class="text-accent">a</span>tions
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lead font-light text-fg-muted">
      {t.portfolio.text[0]}<br />{t.portfolio.text[1]}<br />{t.portfolio.text[2]}
    </p>
  </header>

  <div class="mx-auto mt-16 max-w-6xl px-4 md:mt-24 md:px-8">
    {
      batches.map((batch, b) => (
        <div
          class="portfolio-batch grid grid-cols-6 items-start gap-x-3 gap-y-6 md:grid-cols-12 md:gap-x-5 md:gap-y-10 [&+&]:mt-6 md:[&+&]:mt-10"
          data-batch={b}
          hidden={b > 0}
        >
          {batch.map((photo, i) => (
            <button
              type="button"
              class:list={['group block w-full', slots[b][i], b === 0 && i >= MOBILE_FIRST && 'mobile-extra max-md:hidden']}
              data-lightbox={photo.index}
              data-full={photo.full}
              data-alt={photo.alt}
              aria-label={`${t.portfolio.enlarge}: ${photo.alt}`}
            >
              <span class="photo block shadow-[0_0_0_1px_var(--line)]">
                <Picture
                  src={photo.src}
                  alt={photo.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={photo.landscape ? [720, 1000, 1400, 1600] : [480, 720, 1000]}
                  sizes={photo.landscape ? '(min-width: 1200px) 960px, 100vw' : '(min-width: 1024px) 500px, (min-width: 768px) 45vw, 85vw'}
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
                />
              </span>
            </button>
          ))}
        </div>
      ))
    }

    <div id="portfolio-actions" class="mt-20 flex scroll-mt-28 flex-wrap justify-center gap-3 md:mt-28">
      <button
        type="button"
        id="portfolio-more"
        class="btn btn-ghost"
        data-remaining={photos.length - PORTFOLIO_FIRST}
        data-mobile-extra={PORTFOLIO_FIRST - MOBILE_FIRST}
      >
        {t.portfolio.more} <span class="text-fg-muted" data-count>({photos.length - PORTFOLIO_FIRST})</span>
      </button>
      <button type="button" id="portfolio-less" class="btn btn-ghost" hidden>
        {t.portfolio.less} <span aria-hidden="true">↑</span>
      </button>
    </div>
  </div>

  <div class="reveal mx-auto mt-24 max-w-screen-2xl px-5 text-center md:mt-36 md:px-10">
    <h3 class="text-title font-light tracking-title uppercase">
      {t.portfolio.next[0]} <span class="text-accent">{t.portfolio.next[1]}</span>
    </h3>
    <!-- Su mobile c'è già la barra fissa in basso: qui niente doppione -->
    <div class="mt-10 hidden flex-wrap items-center justify-center gap-2 sm:gap-3 md:flex">
      <a href="#contatti" class="btn" data-track="cta_click" data-label="get in touch" data-position="portfolio">
        {t.cta.getInTouch} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <WhatsAppLink position="portfolio" />
    </div>
    <BrochureLink position="portfolio" class="mt-8 md:mt-5" />
  </div>
</section>

<script>
  const more = document.getElementById('portfolio-more') as HTMLButtonElement;
  const less = document.getElementById('portfolio-less') as HTMLButtonElement;
  const actions = document.getElementById('portfolio-actions')!;
  const count = more.querySelector('[data-count]')!;
  const total = Number(more.dataset.remaining);
  let remaining = total;
  const mobile = window.matchMedia('(max-width: 767px)');
  const extras = () => document.querySelectorAll<HTMLElement>('#portfolio .mobile-extra');
  const extraItems = [...extras()];
  const showCount = () => (count.textContent = `(${remaining + (mobile.matches ? extras().length : 0)})`);
  showCount();
  mobile.addEventListener('change', showCount);

  more.addEventListener('click', () => {
    less.hidden = false;
    // Telefono: prima le foto della selezione nascoste
    if (mobile.matches && extras().length) {
      extras().forEach((el) => el.classList.remove('mobile-extra', 'max-md:hidden'));
      showCount();
      return;
    }
    const next = document.querySelector<HTMLElement>('.portfolio-batch[hidden]');
    if (!next) return;
    next.hidden = false;
    remaining -= next.querySelectorAll('[data-lightbox]').length;
    showCount();
    if (!document.querySelector('.portfolio-batch[hidden]')) more.hidden = true;
  });

  // Richiude tutto e riporta la vista sui bottoni, così chi legge non si perde
  less.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.portfolio-batch:not([data-batch="0"])').forEach((b) => (b.hidden = true));
    extraItems.forEach((el) => el.classList.add('mobile-extra', 'max-md:hidden'));
    remaining = total;
    showCount();
    more.hidden = false;
    less.hidden = true;
    actions.scrollIntoView({ block: 'center', behavior: 'instant' });
    more.focus({ preventScroll: true });
  });
</script>
