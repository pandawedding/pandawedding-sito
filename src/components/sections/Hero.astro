---
import WhatsAppLink from '../WhatsAppLink.astro';
import { getImage } from 'astro:assets';
import { t as tr } from '../../i18n';
import { getFilms } from '../../data/films';

const t = tr(Astro.currentLocale);
const films = getFilms(Astro.currentLocale === 'it' ? 'it' : 'en');
import mobileSrc from '../../assets/hero/hero-poster-mobile.jpg';
import desktopSrc from '../../assets/hero/hero-poster-desktop.jpg';

// Fotogramma della clip, verticale (mobile) e orizzontale (desktop): si vede finché il video non parte
const srcset = async (src: ImageMetadata, widths: number[], format: 'avif' | 'webp') =>
  (await getImage({ src, widths, format })).srcSet.attribute;

const mobile = { avif: await srcset(mobileSrc, [640, 960], 'avif'), webp: await srcset(mobileSrc, [640, 960], 'webp') };
const desktop = {
  avif: await srcset(desktopSrc, [1280, 1920], 'avif'),
  webp: await srcset(desktopSrc, [1280, 1920], 'webp'),
};
const fallback = await getImage({ src: desktopSrc, width: 1920, format: 'jpg' });

const featured = films.find((f) => f.slug === 'selma-michiel')!;
---

<section id="top" class="relative flex min-h-svh items-end overflow-hidden bg-black">
  <div class="hero-media absolute inset-0">
    <picture class="absolute inset-0">
      <source media="(min-width: 768px)" type="image/avif" srcset={desktop.avif} sizes="100vw" />
      <source media="(min-width: 768px)" type="image/webp" srcset={desktop.webp} sizes="100vw" />
      <source type="image/avif" srcset={mobile.avif} sizes="100vw" />
      <source type="image/webp" srcset={mobile.webp} sizes="100vw" />
      <img
        src={fallback.src}
        alt={t.hero.alt}
        fetchpriority="high"
        decoding="async"
        class="size-full object-cover"
      />
    </picture>
    <!-- Clip in loop dal trailer di Selma e Michiel: compare sopra la foto quando parte -->
    <video
      id="hero-video"
      class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-300 data-[playing]:opacity-100"
      data-src-desktop="/videos/hero-villa-arvedi-1080.mp4"
      data-src-mobile="/videos/hero-villa-arvedi-vertical.mp4"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
    ></video>
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-black/30"></div>
  <!-- Velo in alto: logo e menu restano leggibili anche sulle scene chiare del video -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-36 bg-gradient-to-b from-black/60 to-transparent md:h-44" aria-hidden="true"></div>

  <!-- Trailer e audio in alto a destra, fuori dal centro dell'immagine. L'audio compare sotto quando il video parte -->
  <div class="absolute top-20 right-5 z-10 flex flex-col items-end gap-2 md:top-28 md:right-10">
    <button
      type="button"
      data-film={featured.slug}
      class="group relative inline-flex items-center gap-2 rounded-full bg-white/10 py-1 pr-3 pl-1 text-[0.625rem] font-semibold tracking-[0.15em] text-white uppercase backdrop-blur-md transition-colors after:absolute after:inset-x-0 after:-inset-y-1.5 hover:bg-white/20 md:gap-3 md:py-2 md:pr-4 md:pl-2 md:text-[0.6875rem] md:tracking-[0.2em] md:after:hidden"
    >
      <span class="flex size-6 items-center justify-center rounded-full bg-accent text-[0.5rem] md:size-7 md:text-[0.625rem]" aria-hidden="true">▶</span>
      <span>{featured.couple}</span>
    </button>

    <!-- I browser bloccano l'autoplay con audio: il video parte muto, l'audio si attiva qui -->
    <button
      id="hero-sound"
      type="button"
      aria-pressed="false"
      class="relative inline-flex items-center gap-1.5 rounded-full bg-white/10 py-1.5 pr-3 pl-2.5 text-[0.625rem] font-semibold tracking-[0.15em] text-white uppercase backdrop-blur-md transition-colors after:absolute after:inset-x-0 after:-inset-y-1.5 hover:bg-white/20 md:gap-2 md:py-2 md:pr-4 md:pl-3 md:text-[0.6875rem] md:tracking-[0.2em]"
      hidden
    >
      <svg class="size-3.5 md:size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M11 5 6 9H2v6h4l5 4V5Z" fill="currentColor" stroke="none" />
        <path data-wave d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" stroke-linecap="round" />
        <path data-mute d="m16 9 6 6m0-6-6 6" stroke-linecap="round" />
      </svg>
      <span data-sound-label data-on={t.hero.soundOn} data-off={t.hero.soundOff}>{t.hero.soundOn}</span>
    </button>
  </div>

  <div class="relative mx-auto flex w-full max-w-screen-2xl flex-col items-center px-5 pt-28 pb-14 text-center md:px-10 md:pb-20">
    <!-- Il titolo h1 comprende la tagline: è la frase con le parole chiave (fotografi, videomaker, Verona) -->
    <h1 class="flex flex-col items-center">
      <span class="block text-display font-light tracking-title text-white uppercase">
        {t.hero.title[0]}<br class="md:hidden" /> {t.hero.title[1]} <span class="text-accent">{t.hero.title[2]}</span><br />
        {t.hero.title[3]} <span class="text-accent">{t.hero.title[4]}</span>
      </span>
      <span class="mt-10 block max-w-xs text-[0.75rem] leading-relaxed font-medium tracking-label text-white/75 uppercase md:max-w-none">
        {t.tagline}
      </span>
    </h1>

    <div class="mt-6 flex flex-col items-center gap-6">
      <div class="flex flex-wrap justify-center gap-x-8">
        <a href="#contatti" class="cta-link" data-track="cta_click" data-label="get in touch" data-position="hero">
          {t.cta.getInTouch} <span class="chevron" aria-hidden="true">›</span>
        </a>
        <WhatsAppLink variant="link" position="hero" class="text-white!" />
      </div>
    </div>
  </div>
</section>

<style>
  /* Leggero parallax solo dove lo scroll guida l'animazione in CSS */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-media {
        animation: hero-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }
  @keyframes hero-drift {
    to {
      transform: translateY(12%) scale(1.05);
    }
  }

  #hero-sound[aria-pressed='true'] [data-mute],
  #hero-sound[aria-pressed='false'] [data-wave] {
    display: none;
  }
</style>

<script>
  import { canAutoplay, pauseWhenHidden } from '../../scripts/autoplay';

  const video = document.getElementById('hero-video') as HTMLVideoElement;
  if (canAutoplay()) {
    const desktop = matchMedia('(min-width: 768px)').matches;
    video.muted = true;
    video.autoplay = true;
    video.src = (desktop ? video.dataset.srcDesktop : video.dataset.srcMobile)!;
    video.addEventListener('playing', () => video.toggleAttribute('data-playing', true), { once: true });
    pauseWhenHidden(video, document.getElementById('top')!);
    initSound(video);
  }

  // Audio su richiesta: si sente finché l'hero è in vista, poi sfuma e torna muto
  function initSound(video: HTMLVideoElement) {
    const button = document.getElementById('hero-sound') as HTMLButtonElement;
    const label = button.querySelector<HTMLElement>('[data-sound-label]')!;
    let fadeTimer = 0;

    // Dissolvenza del volume; su iOS il volume è di sola lettura, quindi chiude comunque dopo 12 passi
    const fadeTo = (target: number, done?: () => void) => {
      clearInterval(fadeTimer);
      let steps = 0;
      fadeTimer = window.setInterval(() => {
        const next = video.volume + (target > video.volume ? 0.1 : -0.1);
        video.volume = Math.min(1, Math.max(0, next));
        if (Math.abs(video.volume - target) < 0.05 || ++steps >= 12) {
          video.volume = target;
          clearInterval(fadeTimer);
          done?.();
        }
      }, 40);
    };

    const setSound = (on: boolean) => {
      button.setAttribute('aria-pressed', String(on));
      label.textContent = (on ? label.dataset.off : label.dataset.on)!;
      if (on) {
        video.volume = 0;
        video.muted = false;
        video.play().catch(() => {});
        fadeTo(1);
      } else {
        fadeTo(0, () => (video.muted = true));
      }
    };

    video.addEventListener('playing', () => (button.hidden = false), { once: true });
    button.addEventListener('click', () => setSound(video.muted));
    // Se parte un trailer completo, l'hero tace
    document.addEventListener('film_play', () => !video.muted && setSound(false));

    // Quando l'hero è visibile per meno di metà, l'audio si spegne
    new IntersectionObserver(
      ([entry]) => {
        if (entry.intersectionRatio < 0.5 && !video.muted) setSound(false);
      },
      { threshold: [0, 0.5] },
    ).observe(document.getElementById('top')!);
  }
</script>
