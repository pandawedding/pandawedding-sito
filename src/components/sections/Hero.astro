---
import WhatsAppLink from '../WhatsAppLink.astro';
import { getImage } from 'astro:assets';
import { site } from '../../data/site';
import { films } from '../../data/films';
import mobileSrc from '../../assets/PORTFOLIO/Portfolio_Pandabrosproductions_0043.jpg';
import desktopSrc from '../../assets/PORTFOLIO/Portfolio_Pandabrosproductions_0050.jpg';

// Foto diversa per verticale (mobile) e orizzontale (desktop)
const srcset = async (src: ImageMetadata, widths: number[], format: 'avif' | 'webp') =>
  (await getImage({ src, widths, format })).srcSet.attribute;

const mobile = { avif: await srcset(mobileSrc, [640, 960], 'avif'), webp: await srcset(mobileSrc, [640, 960], 'webp') };
const desktop = {
  avif: await srcset(desktopSrc, [1280, 1600], 'avif'),
  webp: await srcset(desktopSrc, [1280, 1600], 'webp'),
};
const fallback = await getImage({ src: desktopSrc, width: 1600, format: 'jpg' });

const featured = films.find((f) => f.slug === 'imani-john')!;
---

<section id="top" class="relative flex min-h-svh items-end overflow-hidden bg-black">
  <div class="hero-media absolute inset-0">
    <picture class="absolute inset-0">
      <source media="(min-width: 768px)" type="image/avif" srcset={desktop.avif} sizes="100vw" />
      <source media="(min-width: 768px)" type="image/webp" srcset={desktop.webp} sizes="100vw" />
      <source type="image/avif" srcset={mobile.avif} sizes="100vw" />
      <source type="image/webp" srcset={mobile.webp} sizes="100vw" />
      <img
        src={fallback.src}
        alt="Sposi che corrono mano nella mano su un prato al tramonto, davanti a una villa storica"
        fetchpriority="high"
        decoding="async"
        class="size-full object-cover object-[50%_60%]"
      />
    </picture>
    <!-- Clip in loop dal trailer di Imani e John: compare sopra la foto quando parte -->
    <video
      id="hero-video"
      class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-1000 data-[playing]:opacity-100"
      data-src-desktop="/videos/hero-imani-john-1080.mp4"
      data-src-mobile="/videos/hero-imani-john-vertical.mp4"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
    ></video>
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-black/30"></div>

  <div class="relative mx-auto flex w-full max-w-screen-2xl flex-col items-center px-5 pt-28 pb-14 text-center md:px-10 md:pb-20">
    <button
      type="button"
      data-film={featured.slug}
      class="group mb-8 inline-flex items-center gap-3 rounded-full bg-white/10 py-2 pr-4 pl-2 text-[0.6875rem] font-semibold tracking-[0.2em] text-white uppercase backdrop-blur-md transition-colors hover:bg-white/20"
    >
      <span class="flex size-7 items-center justify-center rounded-full bg-accent text-[0.625rem]" aria-hidden="true">▶</span>
      <span>{featured.couple}</span>
    </button>

    <h1 class="text-display font-light tracking-title text-white uppercase">
      Stories made<br class="md:hidden" /> to be <span class="text-accent">felt,</span><br />
      not simply <span class="text-accent">remembered</span>
    </h1>

    <div class="mt-10 flex flex-col items-center gap-6">
      <p class="max-w-xs text-[0.75rem] leading-relaxed font-medium tracking-label text-white/75 uppercase md:max-w-none">
        {site.tagline}
      </p>
      <div class="flex flex-wrap justify-center gap-x-8">
        <a href="#contatti" class="cta-link" data-track="cta_click" data-label="get in touch" data-position="hero">
          Get in touch <span class="chevron" aria-hidden="true">›</span>
        </a>
        <WhatsAppLink variant="link" position="hero" class="text-white!" />
      </div>
    </div>
  </div>

  <!-- I browser bloccano l'autoplay con audio: il video parte muto, l'audio si attiva qui -->
  <button
    id="hero-sound"
    type="button"
    aria-pressed="false"
    class="absolute top-20 right-5 z-10 inline-flex items-center gap-2 rounded-full bg-white/10 py-2 pr-4 pl-3 text-[0.6875rem] font-semibold tracking-[0.2em] text-white uppercase backdrop-blur-md transition-colors hover:bg-white/20 md:top-28 md:right-10"
    hidden
  >
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M11 5 6 9H2v6h4l5 4V5Z" fill="currentColor" stroke="none" />
      <path data-wave d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" stroke-linecap="round" />
      <path data-mute d="m16 9 6 6m0-6-6 6" stroke-linecap="round" />
    </svg>
    <span data-sound-label>Sound on</span>
  </button>
</section>

<style>
  /* Leggero parallax solo dove lo scroll guida l'animazione in CSS */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-media {
        animation: hero-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
    }
  }
  @keyframes hero-drift {
    to {
      transform: translateY(12%) scale(1.05);
    }
  }

  #hero-sound[aria-pressed='true'] [data-mute],
  #hero-sound[aria-pressed='false'] [data-wave] {
    display: none;
  }
</style>

<script>
  import { canAutoplay, pauseWhenHidden } from '../../scripts/autoplay';

  const video = document.getElementById('hero-video') as HTMLVideoElement;
  if (canAutoplay()) {
    const desktop = matchMedia('(min-width: 768px)').matches;
    video.muted = true;
    video.autoplay = true;
    video.src = (desktop ? video.dataset.srcDesktop : video.dataset.srcMobile)!;
    video.addEventListener('playing', () => video.toggleAttribute('data-playing', true), { once: true });
    pauseWhenHidden(video, document.getElementById('top')!);
    initSound(video);
  }

  // Audio su richiesta: si sente finché l'hero è in vista, poi sfuma e torna muto
  function initSound(video: HTMLVideoElement) {
    const button = document.getElementById('hero-sound') as HTMLButtonElement;
    const label = button.querySelector('[data-sound-label]')!;
    let fadeTimer = 0;

    // Dissolvenza del volume; su iOS il volume è di sola lettura, quindi chiude comunque dopo 12 passi
    const fadeTo = (target: number, done?: () => void) => {
      clearInterval(fadeTimer);
      let steps = 0;
      fadeTimer = window.setInterval(() => {
        const next = video.volume + (target > video.volume ? 0.1 : -0.1);
        video.volume = Math.min(1, Math.max(0, next));
        if (Math.abs(video.volume - target) < 0.05 || ++steps >= 12) {
          video.volume = target;
          clearInterval(fadeTimer);
          done?.();
        }
      }, 40);
    };

    const setSound = (on: boolean) => {
      button.setAttribute('aria-pressed', String(on));
      label.textContent = on ? 'Sound off' : 'Sound on';
      if (on) {
        video.volume = 0;
        video.muted = false;
        video.play().catch(() => {});
        fadeTo(1);
      } else {
        fadeTo(0, () => (video.muted = true));
      }
    };

    video.addEventListener('playing', () => (button.hidden = false), { once: true });
    button.addEventListener('click', () => setSound(video.muted));
    // Se parte un trailer completo, l'hero tace
    document.addEventListener('film_play', () => !video.muted && setSound(false));

    // Quando l'hero è visibile per meno di metà, l'audio si spegne
    new IntersectionObserver(
      ([entry]) => {
        if (entry.intersectionRatio < 0.5 && !video.muted) setSound(false);
      },
      { threshold: [0, 0.5] },
    ).observe(document.getElementById('top')!);
  }
</script>
