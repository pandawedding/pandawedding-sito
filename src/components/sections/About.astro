---
import Photo from '../Photo.astro';
// TODO: sostituire con i due ritratti definitivi di Pierluigi e Alberto (per ora segnaposto con la foto del team)
import placeholder from '../../assets/team/pierluigi-alberto.jpg';
import { t as tr } from '../../i18n';

const t = tr(Astro.currentLocale);
---

<!-- Impaginazione editoriale: le due foto vicine e inclinate accanto al testo -->
<section id="about" class="pt-8 pb-20 md:pt-12 md:pb-28" aria-labelledby="about-title">
  <div class="mx-auto max-w-screen-xl px-5 md:px-10">
    <header class="reveal mx-auto max-w-4xl text-center">
      <p class="label">{t.about.kicker}</p>
      <h2 id="about-title" class="mt-4 text-display font-light tracking-title">
        {t.about.title[0]} <span class="text-accent">{t.about.title[1]}</span>
      </h2>
    </header>

    <!-- Le due foto vicine, piccole e inclinate, accanto al testo (su mobile sopra) -->
    <div class="mt-14 grid items-center gap-14 md:mt-24 md:grid-cols-[5fr_7fr] md:gap-16">
      <div class="reveal flex items-start justify-center">
        <Photo
          src={placeholder}
          alt={t.about.placeholderAlt}
          ratio="4 / 5"
          sizes="(min-width: 768px) 14rem, 40vw"
          widths={[320, 480, 640]}
          class="w-[40%] max-w-56 -rotate-3 shadow-2xl shadow-black/50"
        >
          <span class="badge">Da sostituire</span>
        </Photo>
        <Photo
          src={placeholder}
          alt={t.about.placeholderAlt}
          ratio="4 / 5"
          sizes="(min-width: 768px) 14rem, 40vw"
          widths={[320, 480, 640]}
          class="-ml-4 mt-12 w-[40%] max-w-56 rotate-[2.5deg] shadow-2xl shadow-black/50 md:-ml-6 md:mt-16"
        >
          <span class="badge">Da sostituire</span>
        </Photo>
      </div>

      <div class="reveal text-center md:text-left">
        <p class="text-title font-light">
          {t.about.claim[0]}<br />
          <span class="text-accent">{t.about.claim[1]}</span>
        </p>
        <h3 class="label mt-14">{t.about.research}</h3>
        <div class="mt-8 space-y-6 text-lead font-light text-fg-muted">
          <p>{t.about.p1}</p>
          <p class="text-fg">{t.about.p2}</p>
          <p>{t.about.p3}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .badge {
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.75rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.7);
    padding: 0.375rem 0.75rem;
    text-align: center;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: #fff;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }
</style>
