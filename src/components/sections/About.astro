---
import Photo from '../Photo.astro';
// TODO: sostituire con i due ritratti definitivi di Pierluigi e Alberto (per ora segnaposto con la foto del team)
import placeholder from '../../assets/team/pierluigi-alberto.jpg';
---

<!-- Impaginazione editoriale: le due foto vicine e inclinate accanto al testo -->
<section id="about" class="pt-8 pb-20 md:pt-12 md:pb-28" aria-labelledby="about-title">
  <div class="mx-auto max-w-screen-xl px-5 md:px-10">
    <header class="reveal mx-auto max-w-4xl text-center">
      <p class="label">About Us</p>
      <h2 id="about-title" class="mt-4 text-display font-light tracking-title">
        The right team makes the <span class="text-accent">difference</span>
      </h2>
    </header>

    <!-- Le due foto vicine, piccole e inclinate, accanto al testo (su mobile sopra) -->
    <div class="mt-14 grid items-center gap-14 md:mt-24 md:grid-cols-[5fr_7fr] md:gap-16">
      <div class="reveal flex items-start justify-center">
        <Photo
          src={placeholder}
          alt="Foto segnaposto, da sostituire"
          ratio="4 / 5"
          sizes="(min-width: 768px) 14rem, 40vw"
          widths={[320, 480, 640]}
          class="w-[40%] max-w-56 -rotate-3 shadow-2xl shadow-black/50"
        >
          <span class="badge">Da sostituire</span>
        </Photo>
        <Photo
          src={placeholder}
          alt="Foto segnaposto, da sostituire"
          ratio="4 / 5"
          sizes="(min-width: 768px) 14rem, 40vw"
          widths={[320, 480, 640]}
          class="-ml-4 mt-12 w-[40%] max-w-56 rotate-[2.5deg] shadow-2xl shadow-black/50 md:-ml-6 md:mt-16"
        >
          <span class="badge">Da sostituire</span>
        </Photo>
      </div>

      <div class="reveal text-center md:text-left" lang="en">
        <p class="text-title font-light">
          Photography captures the moment<br />
          <span class="text-accent">Cinema brings you back to it</span>
        </p>
        <h3 class="label mt-14">Research &amp; Approach</h3>
        <div class="mt-8 space-y-6 text-lead font-light text-fg-muted">
          <p>
            Our work lives at the intersection of documentary spontaneity, editorial aesthetics, and cinematic emotion.
          </p>
          <p class="text-fg">We believe in elegance without artifice, and spontaneity with intention.</p>
          <p>
            We personally guide every wedding, working seamlessly together or alongside our trusted team—all united by
            a single vision: to observe, interpret, and craft an authentic story of your day.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .badge {
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.75rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.7);
    padding: 0.375rem 0.75rem;
    text-align: center;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: #fff;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }
</style>
