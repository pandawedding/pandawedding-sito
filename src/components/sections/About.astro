---
import Photo from '../Photo.astro';
import { site } from '../../data/site';
// TODO: sostituire con le due foto definitive (per ora segnaposto con la foto del team)
import placeholder from '../../assets/team/pierluigi-alberto.jpg';

const photos = [
  { alt: 'Foto segnaposto, da sostituire' },
  { alt: 'Foto segnaposto, da sostituire' },
];
---

<section id="about" class="py-24 md:py-40" aria-labelledby="about-title">
  <div class="mx-auto max-w-screen-2xl px-5 md:px-10">
    <header class="reveal mx-auto max-w-4xl text-center">
      <p class="label">About Us</p>
      <h2 id="about-title" class="mt-4 text-display font-light tracking-title">
        The right team makes the <span class="text-accent">difference</span>
      </h2>
    </header>

    <div class="mt-14 flex flex-col items-center gap-12 text-center md:mt-20 md:gap-16">
      <p class="reveal text-title font-light">
        Photography captures the moment<br />
        <span class="text-accent">Cinema brings you back to it</span>
      </p>
      <div class="reveal grid w-full max-w-md grid-cols-2 gap-3 md:gap-4">
        {
          photos.map((photo, i) => (
            <Photo
              src={placeholder}
              alt={photo.alt}
              ratio="4 / 5"
              sizes="(min-width: 768px) 14rem, 45vw"
              widths={[320, 480, 640]}
              class:list={[i === 1 && 'md:translate-y-10']}
            >
              <span class="absolute inset-x-3 bottom-3 rounded-full bg-black/70 px-3 py-1.5 text-center text-[0.625rem] font-semibold tracking-[0.18em] text-white uppercase backdrop-blur-sm">
                Da sostituire
              </span>
            </Photo>
          ))
        }
      </div>
    </div>

    <div class="reveal mx-auto mt-24 max-w-2xl border-t border-line pt-12 text-center md:mt-36" lang="en">
      <h3 class="label">Research &amp; Approach</h3>
      <div class="mt-8 space-y-6 text-lead font-light text-fg-muted">
        <p>
          Our work lives at the intersection of documentary spontaneity, editorial aesthetics, and cinematic emotion.
        </p>
        <p class="text-fg">We believe in elegance without artifice, and spontaneity with intention.</p>
        <p>
          We personally guide every wedding, working seamlessly together or alongside our trusted team—all united by a
          single vision: to observe, interpret, and craft an authentic story of your day.
        </p>
      </div>
    </div>

    <div class="reveal mt-20 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 md:mt-28">
      <a href="#contatti" class="btn" data-track="cta_click" data-label="get in touch" data-position="about">
        Get in touch <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener"
        class="cta-link"
        data-track="click_whatsapp"
        data-position="about"
      >
        Message us on WhatsApp <span class="chevron" aria-hidden="true">›</span>
      </a>
    </div>
  </div>
</section>
