---
import WhatsAppLink from '../WhatsAppLink.astro';
import { Picture } from 'astro:assets';
import ScrollRow from '../ScrollRow.astro';
import { films } from '../../data/films';
---

<!-- Frames: i film, in una riga stile Netflix -->
<section id="films" class="pt-8 pb-20 md:pt-12 md:pb-28" aria-labelledby="films-title">
  <header class="reveal mx-auto max-w-screen-2xl px-5 text-center md:px-10">
    <p class="label">Wedding Films</p>
    <h2 id="films-title" class="mt-4 text-display font-light tracking-title">
      Fr<span class="text-accent">a</span>mes
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lead font-light text-fg-muted">
      <span class="text-fg">frame by frame a day becomes a story</span><br />
      crafted from real moments, cinematic vision and genuine emotion.
    </p>
  </header>

  <!-- Riga orizzontale: si scorre su mobile e tablet, da 1280px i film stanno tutti affiancati -->
  <ScrollRow name="films" label="Wedding films" class="mt-12 md:mt-16">
    {
      films.map((film) => (
        <article class="w-[85vw] max-w-[44rem] md:w-[44vw] xl:w-[calc((100%-3rem)/4)]">
          <button
            type="button"
            data-film={film.slug}
            class="group block w-full text-left"
            aria-label={`Guarda il trailer di ${film.couple}, ${film.location}`}
          >
            <div class="photo relative aspect-video">
              <Picture
                src={film.poster}
                alt=""
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[640, 960, 1280]}
                sizes="(min-width: 1280px) 25vw, (min-width: 768px) 44vw, 85vw"
                loading="lazy"
                class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.04]"
              />
              <video
                class="film-preview absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-500 data-[playing]:opacity-100"
                data-preview={film.preview}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
              />
              <div class="absolute inset-0 bg-black/10" />
              <span
                class="absolute bottom-4 left-4 flex size-12 items-center justify-center rounded-full bg-accent text-sm text-white transition-transform duration-500 ease-out-soft group-hover:scale-110 md:bottom-6 md:left-6 md:size-14"
                aria-hidden="true"
              >
                ▶
              </span>
            </div>
          </button>
          <p class="label mt-6">{film.location}</p>
          <h3 class="mt-3 text-title font-light">{film.couple}</h3>
          {film.text && <p class="mt-3 max-w-md leading-relaxed font-light text-fg-muted">{film.text}</p>}
          <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
            <button type="button" data-film={film.slug} class="cta-link">
              Watch the trailer <span class="chevron" aria-hidden="true">›</span>
            </button>
            <a
              href="#full-film"
              data-request-film={film.couple}
              data-track="cta_click"
              data-label="request full film"
              data-position="film card"
              class="cta-link text-fg-muted!"
            >
              Request the full film <span class="chevron" aria-hidden="true">›</span>
            </a>
          </div>
        </article>
      ))
    }
  </ScrollRow>

  <!-- Richiesta del film completo: i trailer sono pubblici, i film interi si mandano in privato.
       Non invia nulla: porta luogo ed email nel form dei contatti in fondo alla pagina. -->
  <div id="full-film" class="reveal mx-auto mt-16 max-w-screen-lg scroll-mt-28 px-5 md:mt-24 md:px-10">
    <div class="grid gap-10 rounded-[6px] bg-bg-raised p-7 md:grid-cols-[1fr_1.15fr] md:items-center md:gap-14 md:p-12">
      <div class="text-center md:text-left">
        <p class="label">Full films</p>
        <h3 class="mt-4 text-title font-light tracking-title uppercase">
          Watch a <span class="text-accent">full</span> film
        </h3>
        <p class="mt-5 leading-relaxed font-light text-fg-muted">
          Trailers are only the beginning. Tell us where you’re getting married and we’ll privately share a complete
          film from a wedding like yours.
        </p>
      </div>

      <form id="full-film-form" class="grid gap-4 sm:grid-cols-2" novalidate>
        <input type="hidden" name="film" />
        <label class="flex flex-col gap-2">
          <span class="text-[0.6875rem] font-semibold tracking-[0.2em] text-fg-muted uppercase">
            Where <span class="text-accent">*</span>
          </span>
          <input name="venue" type="text" required placeholder="Villa, city or region" class="request-field" />
        </label>
        <label class="flex flex-col gap-2">
          <span class="text-[0.6875rem] font-semibold tracking-[0.2em] text-fg-muted uppercase">
            Email <span class="text-accent">*</span>
          </span>
          <input
            name="email"
            type="email"
            required
            placeholder="name@email.com"
            autocomplete="email"
            class="request-field"
          />
        </label>
        <div class="flex flex-col items-center gap-3 sm:col-span-2 sm:flex-row sm:flex-wrap md:items-center">
          <button
            type="submit"
            class="btn w-full justify-center sm:w-auto"
            data-track="cta_click"
            data-label="request full film"
            data-position="films"
          >
            Request a full film <span class="arrow" aria-hidden="true">→</span>
          </button>
          <WhatsAppLink position="full film" />
        </div>
        <p data-film-note class="text-sm text-fg-muted sm:col-span-2" hidden></p>
      </form>
    </div>
  </div>
</section>

<style>
  .request-field {
    width: 100%;
    min-height: 3rem;
    padding: 0.85rem 1rem 0.7rem;
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 1rem; /* evita lo zoom automatico su iOS */
    transition: box-shadow 0.2s;
  }
  .request-field::placeholder {
    color: var(--fg-muted);
    opacity: 0.6;
  }
  .request-field:focus,
  .request-field[aria-invalid='true'] {
    outline: none;
    box-shadow: inset 0 0 0 1px var(--accent);
  }
</style>

<script>
  import { canAutoplay } from '../../scripts/autoplay';

  // Anteprime in autoplay muto (anche su mobile): partono quando la card entra
  // nello schermo e si fermano quando esce. Il poster resta finché il video non gira.
  if (canAutoplay() && 'IntersectionObserver' in window) {
    const visible = new Set<HTMLVideoElement>();
    const sync = (video: HTMLVideoElement) => {
      if (visible.has(video) && !document.hidden) {
        video.play().then(() => video.toggleAttribute('data-playing', true)).catch(() => {});
      } else {
        video.pause();
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            visible.add(video);
            if (!video.src) {
              video.src = video.dataset.preview!;
              video.addEventListener('canplay', () => sync(video), { once: true });
            }
          } else {
            visible.delete(video);
          }
          sync(video);
        }
      },
      { threshold: 0.4 },
    );
    document.querySelectorAll<HTMLVideoElement>('.film-preview').forEach((video) => {
      video.muted = true;
      video.autoplay = true;
      io.observe(video);
    });
    document.addEventListener('visibilitychange', () => {
      document.querySelectorAll<HTMLVideoElement>('.film-preview').forEach(sync);
    });
  }

  // "Request the full film" su una card: ricorda il film scelto nel riquadro di richiesta
  const requestForm = document.getElementById('full-film-form') as HTMLFormElement;
  const filmNote = requestForm.querySelector<HTMLElement>('[data-film-note]')!;
  document.querySelectorAll<HTMLAnchorElement>('[data-request-film]').forEach((link) => {
    link.addEventListener('click', () => {
      requestForm.film.value = link.dataset.requestFilm!;
      filmNote.textContent = `Film: ${link.dataset.requestFilm}`;
      filmNote.hidden = false;
    });
  });

  // Invio del riquadro: niente email qui, porta luogo ed email nel form dei contatti
  requestForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const fields = [...requestForm.querySelectorAll<HTMLInputElement>('input[required]')];
    fields.forEach((el) => el.setAttribute('aria-invalid', String(!el.checkValidity())));
    const invalid = fields.find((el) => !el.checkValidity());
    if (invalid) {
      invalid.focus();
      return;
    }

    const contact = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!contact) return;
    contact.venue.value = requestForm.venue.value;
    contact.email.value = requestForm.email.value;
    const film = requestForm.film.value;
    const request = film
      ? `We’d love to watch the full film of ${film}, or one from a wedding like ours.`
      : 'We’d love to watch a full film from a wedding like ours.';
    if (!contact.message.value.trim()) contact.message.value = request;
    // Avvia il tracciamento "form iniziato" come se l'utente avesse scritto lì
    contact.dispatchEvent(new Event('input', { bubbles: true }));

    document.getElementById('contatti')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    // Il primo campo ancora vuoto è quasi sempre il nome
    const next = [...contact.querySelectorAll<HTMLInputElement>('input[required], textarea[required]')].find(
      (el) => !el.value.trim(),
    );
    setTimeout(() => (next ?? contact.message).focus({ preventScroll: true }), 600);
  });
</script>
