---
import WhatsAppLink from '../WhatsAppLink.astro';
import { Picture } from 'astro:assets';
import ScrollRow from '../ScrollRow.astro';
import { films } from '../../data/films';
---

<!-- Frames: i film, in una riga stile Netflix -->
<section id="films" class="pt-8 pb-20 md:pt-12 md:pb-28" aria-labelledby="films-title">
  <header class="reveal mx-auto max-w-screen-2xl px-5 text-center md:px-10">
    <p class="label">Wedding Films</p>
    <h2 id="films-title" class="mt-4 text-display font-light tracking-title">
      Fr<span class="text-accent">a</span>mes
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lead font-light text-fg-muted">
      <span class="text-fg">frame by frame a day becomes a story</span><br />
      crafted from real moments, cinematic vision and genuine emotion.
    </p>
  </header>

  <!-- Riga orizzontale: si scorre su mobile e tablet, da 1280px i film stanno tutti affiancati -->
  <ScrollRow name="films" label="Wedding films" class="mt-12 md:mt-16">
    {
      films.map((film) => (
        <article class="w-[85vw] max-w-[44rem] md:w-[44vw] xl:w-[calc((100%-3rem)/4)]">
          <button
            type="button"
            data-film={film.slug}
            class="group block w-full text-left"
            aria-label={`Guarda il trailer di ${film.couple}, ${film.location}`}
          >
            <div class="photo relative aspect-video">
              <Picture
                src={film.poster}
                alt=""
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[640, 960, 1280]}
                sizes="(min-width: 1280px) 25vw, (min-width: 768px) 44vw, 85vw"
                loading="lazy"
                class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.04]"
              />
              <video
                class="film-preview absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-500 data-[playing]:opacity-100"
                data-preview={film.preview}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
              />
              <div class="absolute inset-0 bg-black/10" />
              <span
                class="absolute bottom-4 left-4 flex size-12 items-center justify-center rounded-full bg-accent text-sm text-white transition-transform duration-500 ease-out-soft group-hover:scale-110 md:bottom-6 md:left-6 md:size-14"
                aria-hidden="true"
              >
                ▶
              </span>
            </div>
          </button>
          <p class="label mt-6">{film.location}</p>
          <h3 class="mt-3 text-title font-light">{film.couple}</h3>
          {film.text && <p class="mt-3 max-w-md leading-relaxed font-light text-fg-muted">{film.text}</p>}
          <button type="button" data-film={film.slug} class="cta-link mt-3">
            Watch the trailer <span class="chevron" aria-hidden="true">›</span>
          </button>
        </article>
      ))
    }
  </ScrollRow>

  <div class="reveal mx-auto mt-20 flex max-w-screen-2xl flex-col items-center gap-8 px-5 text-center md:mt-28 md:px-10">
    <p class="text-title font-light tracking-title uppercase">Your emotions in <span class="text-accent">frames</span></p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="#contatti" class="btn" data-track="cta_click" data-label="get in touch" data-position="films">
        Get in touch <span class="arrow" aria-hidden="true">→</span>
      </a>
      <WhatsAppLink position="films" />
    </div>
  </div>
</section>

<script>
  import { canAutoplay } from '../../scripts/autoplay';

  // Anteprime in autoplay muto (anche su mobile): partono quando la card entra
  // nello schermo e si fermano quando esce. Il poster resta finché il video non gira.
  if (canAutoplay() && 'IntersectionObserver' in window) {
    const visible = new Set<HTMLVideoElement>();
    const sync = (video: HTMLVideoElement) => {
      if (visible.has(video) && !document.hidden) {
        video.play().then(() => video.toggleAttribute('data-playing', true)).catch(() => {});
      } else {
        video.pause();
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            visible.add(video);
            if (!video.src) {
              video.src = video.dataset.preview!;
              video.addEventListener('canplay', () => sync(video), { once: true });
            }
          } else {
            visible.delete(video);
          }
          sync(video);
        }
      },
      { threshold: 0.4 },
    );
    document.querySelectorAll<HTMLVideoElement>('.film-preview').forEach((video) => {
      video.muted = true;
      video.autoplay = true;
      io.observe(video);
    });
    document.addEventListener('visibilitychange', () => {
      document.querySelectorAll<HTMLVideoElement>('.film-preview').forEach(sync);
    });
  }
</script>
