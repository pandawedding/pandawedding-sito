---
import Logo from './Logo.astro';
import { site, nav } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-bg">
  <div class="mx-auto max-w-screen-2xl px-5 pt-20 pb-10 md:px-10 md:pt-28">
    <div class="grid gap-14 md:grid-cols-[1.4fr_1fr] md:gap-10">
      <div>
        <a href="/#top" class="inline-block text-[2rem] md:text-6xl" aria-label="PandA Wedding, torna all'inizio">
          <Logo />
        </a>
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          data-track="click_whatsapp"
          class="btn mt-8"
        >
          WhatsApp <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <nav aria-label="Menu footer" class="md:justify-self-end">
        <ul class="space-y-3">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm tracking-[0.18em] uppercase text-fg-muted transition-colors hover:text-fg"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="label mt-20">Stories made to be felt</p>

    <div
      class="mt-6 flex flex-col gap-4 border-t border-line pt-6 text-xs leading-relaxed text-fg-muted md:flex-row md:items-end md:justify-between"
    >
      <p>&copy; {year} {site.name}</p>
      <address class="not-italic md:text-right">
        {site.company.name}
        {site.company.vat && <> · P.IVA {site.company.vat}</>}
        <br />
        {site.company.street}, {site.company.city}
      </address>
    </div>
  </div>
</footer>
