---
import WhatsAppLink from './WhatsAppLink.astro';
import BrochureLink from './BrochureLink.astro';
import Logo from './Logo.astro';
import { site, navFor } from '../data/site';
import { getLang, localePath, ui } from '../i18n';
import { servicesPath } from '../data/services';
import { guidesPath } from '../data/guides';
import { legalPath } from '../data/legal';
import { planners, plannersPath } from '../data/planners';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const nav = navFor(lang);

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-bg">
  <div class="mx-auto max-w-screen-2xl px-5 pt-20 pb-10 md:px-10 md:pt-28">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-14 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] md:gap-10">
      <div>
        <a href={localePath(lang, '/#top')} class="inline-block text-[min(2rem,7.6vw)] md:text-[2.75rem] lg:text-6xl" aria-label={t.header.home}>
          <Logo />
        </a>
        <div class="mt-8 flex flex-wrap gap-2 sm:gap-3">
          <a href={localePath(lang, '/#contatti')} class="btn" data-track="cta_click" data-label="get in touch" data-position="footer">
            {t.cta.getInTouch} <span class="arrow" aria-hidden="true">→</span>
          </a>
          <WhatsAppLink position="footer" />
        </div>
        <BrochureLink position="footer" class="mt-4" />
      </div>

      <nav aria-label={t.footer.menu} class="md:justify-self-end">
        <ul class="space-y-3">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm tracking-[0.18em] uppercase text-fg-muted transition-colors hover:text-fg"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="label mt-20">{t.footer.claim}</p>

    <div
      class="mt-6 flex flex-col gap-4 border-t border-line pt-6 text-xs leading-relaxed text-fg-muted md:flex-row md:items-end md:justify-between"
    >
      <p>
        &copy; {year} {site.name} ·
        <a href={servicesPath[lang]} class="underline-offset-2 hover:text-fg hover:underline">{t.footer.services}</a> ·
        <a href={guidesPath[lang]} class="underline-offset-2 hover:text-fg hover:underline">{t.footer.guides}</a> ·
        <a href={plannersPath[lang]} class="underline-offset-2 hover:text-fg hover:underline">{planners[lang].footerLink}</a>
        <br />
        <a href={legalPath.privacy[lang]} class="underline-offset-2 hover:text-fg hover:underline">Privacy policy</a> ·
        <a href={legalPath.cookies[lang]} class="underline-offset-2 hover:text-fg hover:underline">Cookie policy</a> ·
        <button type="button" class="underline-offset-2 hover:text-fg hover:underline" data-cookie-settings>{t.consent.settings}</button>
      </p>
      <address class="not-italic md:text-right">
        {site.company.name}
        {site.company.vat && <> · {t.footer.vat} {site.company.vat}</>}
        <br />
        {site.company.street}, {site.company.city}
      </address>
    </div>
  </div>
</footer>
