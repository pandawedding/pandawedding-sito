---
import { t as tr } from '../i18n';
const t = tr(Astro.currentLocale);
// Visore a schermo intero per le foto con data-lightbox (indice), data-full e data-alt.
// Frecce, tastiera e swipe; mostra solo le foto già aperte nella pagina.
---

<dialog id="lightbox" class="m-0 h-dvh max-h-none w-screen max-w-none bg-black/95 p-0 text-white" aria-label={t.lightbox.label}>
  <div class="relative flex h-full items-center justify-center">
    <figure class="flex h-full w-full touch-pan-y touch-pinch-zoom items-center justify-center px-3 py-16 md:px-20">
      <img data-lb-img alt="" class="max-h-full max-w-full rounded-[6px] object-contain transition-[opacity,transform] duration-300 ease-out-soft" />
    </figure>

    <p class="absolute top-5 left-5 text-xs tracking-[0.2em] text-white/70" data-lb-count aria-live="polite"></p>
    <button
      type="button"
      data-lb-close
      class="absolute top-3 right-3 flex size-11 items-center justify-center rounded-full bg-white/10 text-xl hover:bg-white/20"
      aria-label={t.lightbox.close}
    >
      ✕
    </button>
    <button
      type="button"
      data-lb-step="-1"
      class="absolute top-1/2 left-3 hidden size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-xl hover:bg-accent md:flex"
      aria-label={t.lightbox.prev}
    >
      ←
    </button>
    <button
      type="button"
      data-lb-step="1"
      class="absolute top-1/2 right-3 hidden size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-xl hover:bg-accent md:flex"
      aria-label={t.lightbox.next}
    >
      →
    </button>
  </div>
</dialog>

<script>
  import { historyModal } from '../scripts/modal';

  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const openDialog = historyModal(dialog);
  const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const counter = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
  let items: HTMLElement[] = [];
  let pos = 0;

  // Solo le foto dello stesso gruppo (portfolio o singolo diario) già visibili
  const visibleItems = (trigger: HTMLElement) => {
    const group = trigger.closest('[data-lightbox-group]') ?? document;
    return [...group.querySelectorAll<HTMLElement>('[data-lightbox]')].filter((el) => !el.closest('[hidden]'));
  };

  const show = (i: number) => {
    pos = (i + items.length) % items.length;
    const el = items[pos];
    img.style.opacity = '0';
    img.onload = () => (img.style.opacity = '1');
    img.src = el.dataset.full!;
    img.alt = el.dataset.alt ?? '';
    counter.textContent = `${pos + 1} / ${items.length}`;
    // Precarica la successiva
    const next = items[(pos + 1) % items.length];
    if (next) new Image().src = next.dataset.full!;
  };

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
    if (!trigger) return;
    items = visibleItems(trigger);
    openDialog();
    show(items.indexOf(trigger));
  });

  dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelectorAll<HTMLElement>('[data-lb-step]').forEach((btn) =>
    btn.addEventListener('click', () => show(pos + Number(btn.dataset.lbStep))),
  );
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as HTMLElement).tagName === 'FIGURE') dialog.close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(pos + 1);
    if (e.key === 'ArrowLeft') show(pos - 1);
  });

  // Swipe orizzontale su touch: la foto segue il dito.
  // Con due dita, o a pagina già ingrandita, il gesto resta allo zoom del browser.
  let startX = 0;
  let dragging = false;
  const zoomed = () => (window.visualViewport?.scale ?? 1) > 1.01;
  const release = () => {
    dragging = false;
    img.style.transition = '';
    img.style.transform = '';
  };

  dialog.addEventListener(
    'touchstart',
    (e) => {
      if (e.touches.length > 1 || zoomed()) return release();
      dragging = true;
      startX = e.touches[0].clientX;
      img.style.transition = 'none';
    },
    { passive: true },
  );
  dialog.addEventListener(
    'touchmove',
    (e) => {
      if (!dragging) return;
      if (e.touches.length > 1) return release();
      img.style.transform = `translateX(${e.touches[0].clientX - startX}px)`;
    },
    { passive: true },
  );
  dialog.addEventListener(
    'touchend',
    (e) => {
      if (!dragging) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) {
        // La foto cambia senza tornare indietro: quella nuova entra in dissolvenza
        dragging = false;
        img.style.transform = '';
        show(pos + (dx < 0 ? 1 : -1));
        requestAnimationFrame(() => (img.style.transition = ''));
      } else {
        release();
      }
    },
    { passive: true },
  );
  dialog.addEventListener('touchcancel', release, { passive: true });
</script>
