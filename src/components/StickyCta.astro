---
import WhatsAppLink from './WhatsAppLink.astro';
import { t as tr } from '../i18n';
const t = tr(Astro.currentLocale);
// Barra fissa in basso su mobile: compare dopo l'hero, sparisce sui contatti
// e quando un bottone di sezione passa nella fascia in basso (non lo copre mai).
// "Get in touch" con WhatsApp accanto, come nel resto del sito.
---

<div
  id="sticky-cta"
  class="fixed inset-x-3 bottom-3 z-30 flex translate-y-[150%] gap-2 transition-transform duration-500 ease-out-soft data-[show]:translate-y-0 md:hidden"
  inert
>
  <a
    href="#contatti"
    data-track="cta_click"
    data-label="get in touch"
    data-position="sticky"
    class="flex flex-1 items-center justify-between rounded-[6px] bg-accent px-5 py-4 text-[0.75rem] font-semibold tracking-[0.18em] text-white uppercase shadow-lg shadow-black/30 transition-[scale] duration-150 active:scale-[0.97]"
  >
    {t.sticky} <span aria-hidden="true">→</span>
  </a>
  <WhatsAppLink
    position="sticky"
    class="min-h-0! rounded-[6px] bg-bg-raised! px-4! text-[0.75rem]! text-fg! shadow-lg shadow-black/30"
  />
</div>

<script>
  const bar = document.getElementById('sticky-cta')!;
  const hero = document.getElementById('top');
  const contact = document.getElementById('contatti');
  const footer = document.querySelector('footer');
  if (hero && contact && 'IntersectionObserver' in window) {
    const state = { hero: true, end: false, cta: false };
    const update = () => {
      const show = !state.hero && !state.end && !state.cta;
      bar.toggleAttribute('data-show', show);
      // Nascosta: fuori dal tab e dagli screen reader
      bar.inert = !show;
    };
    new IntersectionObserver(([e]) => {
      state.hero = e.isIntersecting;
      update();
    }).observe(hero);
    const ends = new Set<Element>();
    const endIo = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? ends.add(e.target) : ends.delete(e.target)));
      state.end = ends.size > 0;
      update();
    });
    endIo.observe(contact);
    if (footer) endIo.observe(footer);
    document.querySelectorAll("[data-sticky-end]").forEach((el) => endIo.observe(el));

    // I bottoni delle sezioni non finiscono mai sotto la barra: quando uno entra
    // nella fascia in basso dove sta la barra (ultimo 20% dello schermo), la barra si toglie
    const covered = new Set<Element>();
    const ctaIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? covered.add(e.target) : covered.delete(e.target)));
        state.cta = covered.size > 0;
        update();
      },
      { rootMargin: '-80% 0px 0px 0px' },
    );
    document.querySelectorAll('main .btn').forEach((el) => {
      if (!bar.contains(el)) ctaIo.observe(el);
    });
  }
</script>
