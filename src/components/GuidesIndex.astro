---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from './Photo.astro';
import { getGuides, guidesAlternates, guidesPath } from '../data/guides';
import { businessId } from '../data/schema';
import { site } from '../data/site';
import { getLang, localePath, ui } from '../i18n';

// Indice delle guide: card come quelle dei Real Weddings, linkato dal footer e dalla pagina Servizi.
const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const guides = await getGuides(lang);
const url = new URL(Astro.url.pathname, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${url}#page`,
    name: `${t.guides.title[0]} ${t.guides.title[1]}`,
    description: t.guides.intro,
    url,
    inLanguage: t.schemaLocale,
    publisher: { '@id': businessId(Astro.site!) },
    hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.entry.data.title, url: new URL(g.path, Astro.site).href })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: new URL(localePath(lang, '/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: t.guides.kicker, item: url },
    ],
  },
];
---

<BaseLayout title={`${t.guides.title[0]} ${t.guides.title[1]}`} description={t.guides.intro} schema={schema} alternates={guidesAlternates}>
  <section class="pt-28 pb-20 md:pt-40 md:pb-28">
    <header class="reveal mx-auto max-w-4xl px-5 text-center md:px-10">
      <h1 class="label">{t.guides.kicker}</h1>
      <p class="mt-4 text-title font-light tracking-title uppercase">
        {t.guides.title[0]} <span class="text-accent">{t.guides.title[1]}</span>
      </p>
      <p class="mx-auto mt-8 max-w-2xl text-lead font-light text-fg-muted">{t.guides.intro}</p>
    </header>

    <ul class="mx-auto mt-16 grid max-w-screen-xl gap-12 px-5 md:mt-24 md:grid-cols-2 md:gap-10 md:px-10">
      {
        guides.map((g) => (
          <li class="reveal">
            <a href={g.path} class="group block" data-track="cta_click" data-label="read the guide" data-position="guides">
              <span class="photo block overflow-hidden">
                <Photo
                  src={g.entry.data.cover}
                  alt={g.entry.data.coverAlt}
                  ratio="4 / 3"
                  sizes="(min-width: 768px) 45vw, 90vw"
                  imgClass="transition-transform duration-700 group-hover:scale-[1.03]"
                />
              </span>
              <p class="label mt-6">{g.entry.data.label}</p>
              <h2 class="mt-3 text-2xl font-light tracking-title uppercase md:text-3xl">{g.entry.data.title}</h2>
              <p class="mt-4 leading-relaxed font-light text-fg-muted">{g.entry.data.excerpt}</p>
              <span class="cta-link mt-4">
                {t.guides.read} <span class="chevron" aria-hidden="true">›</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
